# The pose recorder's entry in the launcher's app table, merged into the
# recording launcher config (`cogs:robotcpu_record.textproto`) so that one
# supervisor starts and stops every process a recording session runs.
#
# One message of simplelaunch's `AppConfig`. Hand-written for the reason
# `host/host_launch.textproto` and `pod/pod_launch.textproto` are: the renderer
# only knows about Clockwork processes, and the bench is not one -- it is a plain
# process holding the servo bus over the serial node, outside the composition
# entirely.
#
# Every path below is relative to the payload root (the launcher's working
# directory).
#
# `pose-log` and not `--record`: the bench's `--record` flag names where a
# self-test record is written, which has nothing to do with recording poses, and
# one usage text must not say "record" for two unrelated things.
#
# The command reads the nine Present Positions every 20 ms and writes one JSON
# line per sample to its stdout. It writes to no servo register at all: it refuses unless
# every servo reads Torque Enable 0 and it never turns torque on or off itself,
# which is what makes it the one process safe to run with an operator's hands in
# the linkage. Nothing in this config's app table can arm anything -- there is no
# driver and no control process here.
#
# `--config` names the bench's own configuration, which holds the serial node
# this unit's servos are on. That file is a per-unit file and is never in this
# tree; a payload built without one carries no file at this path, and
# `deploy-motion.sh --record` refuses before it starts anything.
#
# Named `recorder` because the launcher spells each app's console
# `<name>_<run>.log` and `recorder_0.log` is the file the operator tails and the
# analyzer reads. Not `bench`: this repo says "bench" for the whole read-only
# command set, and a session records poses with one of them.
app {
  name: "recorder"
  executable: "reachy_bench"
  args: "pose-log"
  args: "--config"
  args: "bench/reachy-bench.toml"
}
