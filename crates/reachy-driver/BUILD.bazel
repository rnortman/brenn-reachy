load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The goal gate: the arbitration a driver applies to a commanded goal, and the
# dead-man timer over it. The simulated driver cog hosts exactly this logic --
# the point of the crate is that the simulation and the real driver cannot
# disagree about when a machine de-torques.
#
# The target name is the crate name, underscored: rules_rust derives the crate
# name from the target, and `reachy-driver` is not a Rust identifier.
rust_library(
    name = "reachy_driver",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = ["//crates/reachy-wire:reachy_wire"],
)

# The dead-man timer is the last thing between a stalled commander and a machine
# holding torque indefinitely, so its suite is part of the gate.
rust_test(
    name = "reachy_driver_test",
    size = "small",
    crate = ":reachy_driver",
)
