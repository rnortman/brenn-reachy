load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Bench binary for Reachy Mini bring-up: read-only self-test registry and the
# bare-bus commands. The deployable — cross-compiled for the device with
# `--platforms=//bazel/platform:reachy-device`.
#
# `crate_name` rather than the derived name: `src/main.rs` says
# `reachy_bench::`, and the target name is taken by the binary below.
#
# `src/main.rs` is excluded from the library's sources for the same reason it is
# the binary's root — it is a separate crate.
rust_library(
    name = "reachy_bench_lib",
    srcs = [
        "src/bare.rs",
        "src/config.rs",
        "src/lib.rs",
        "src/selftest.rs",
        "src/testutil.rs",
    ],
    crate_name = "reachy_bench",
    deps = [
        "//crates/dxl-proto:dxl_proto",
        "//crates/reachy-bus:reachy_bus",
        "//crates/reachy-kin:reachy_kin",
        "//crates/reachy-motion:reachy_motion",
        "@brenn_reachy_crates//:anyhow",
        "@brenn_reachy_crates//:serde",
        "@brenn_reachy_crates//:thiserror",
        "@brenn_reachy_crates//:toml",
    ],
)

# The example configuration comes in through `include_str!`, which is resolved
# by the compiler against its declared inputs, so it is `compile_data`.
rust_test(
    name = "reachy_bench_lib_test",
    size = "medium",
    compile_data = ["reachy-bench.example.toml"],
    crate = ":reachy_bench_lib",
)

# The entry point: argument parsing, the configuration file it reads off disk,
# and the dispatch into the library's commands and registry.
#
# Public because it is a device deployable, and the deployables are named in one
# place (`//bazel/platform:device_deployables`) so the gate cannot cover a
# different set than a deploy ships.
rust_binary(
    name = "reachy_bench",
    srcs = ["src/main.rs"],
    visibility = ["//visibility:public"],
    deps = [
        ":reachy_bench_lib",
        "//crates/reachy-bus:reachy_bus",
        "@brenn_reachy_crates//:anyhow",
    ],
)

# A binary's root is its own crate, so the library's test target never sees the
# argument grammar this file owns. Its tests read the example configuration
# through `include_str!` and touch no file at run time, so this target needs
# `compile_data` and no runfiles.
rust_test(
    name = "reachy_bench_test",
    size = "small",
    compile_data = ["reachy-bench.example.toml"],
    crate = ":reachy_bench",
)
