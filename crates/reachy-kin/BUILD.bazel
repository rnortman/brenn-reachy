load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Head kinematics for the Reachy Mini: the Stewart-platform linkage, forward and
# inverse solutions, and the resting and stowed poses. A Clockwork cog body
# depends on it, and so does the bench.
#
# No `edition` attribute: the Rust toolchain registered in MODULE.bazel carries
# the workspace's edition, and restating it per target is drift waiting to
# happen.
rust_library(
    name = "reachy_kin",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "@brenn_reachy_crates//:nalgebra",
        "@brenn_reachy_crates//:thiserror",
    ],
)

# The vendored geometry file the transcription test checks against reaches it
# through `include_str!`, whose path is relative to the source file, so the file
# is `compile_data` here and needs no runfiles.
rust_test(
    name = "reachy_kin_test",
    size = "small",
    compile_data = ["tests/fixtures/kinematics_data.json"],
    crate = ":reachy_kin",
    deps = ["@brenn_reachy_crates//:serde_json"],
)
