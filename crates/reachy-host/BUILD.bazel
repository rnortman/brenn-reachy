load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# The robot's voice host: the process that holds the voice pipeline, the
# machine's single bus attachment, and the host end of the intent edge. What the
# edge decides is `//crates/reachy-edge`, which is sans-I/O -- this crate is the
# parts a library cannot have: a configuration file, two sockets, and a queue
# the authoring tasks hand bodies to.
#
# `crate_name` rather than the derived name: `src/main.rs` says `reachy_host::`,
# and the target name is taken by the binary below. `src/main.rs` is excluded
# from the library's sources for the same reason it is the binary's root -- it
# is a separate crate.
#
# The generated Protobuf rendering of the host's configuration schema is a
# compile-time input: `params.rs` embeds it and parses every configuration
# against a descriptor compiled from it, so the schema the binary enforces is
# the schema it was built with. `$(execpath)` is enough here: rules_rust renders
# it absolute at the rustc invocation, which is what `include_str!` needs.
rust_library(
    name = "reachy_host_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    compile_data = ["//host:host_config_clk_proto.proto"],
    crate_name = "reachy_host",
    edition = "2024",
    rustc_env = {
        "HOST_PARAMS_PROTO": "$(execpath //host:host_config_clk_proto.proto)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "//crates/reachy-edge:reachy_edge",
        "//host:host_config_clk_rs",
        "@brenn_reachy_crates//:prost-reflect",
        "@brenn_reachy_crates//:protox",
        "@brenn_reachy_crates//:serde_json",
        "@brenn_reachy_crates//:thiserror",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

# The process the robot's voice runs in. Cross-compiled for the device with
# `--platforms=//bazel/platform:reachy-device`.
#
# Both files it reads by path travel with it: its own configuration, at the path
# the binary defaults to, and the clip name table that configuration points at.
# The payload lays both out the same way, because the launcher runs this from the
# payload root and a runfiles tree and that root spell the same relative paths.
#
# A member of `//bazel/platform:motion_payload`, so a unit stages and starts it
# and the gate cross-builds it. What it does there is follow the session's story
# and narrate it: the voice pipeline is not linked in yet.
# TODO(host-payload-membership)
rust_binary(
    name = "reachy_host",
    srcs = ["src/main.rs"],
    data = [
        "//cogs:clip_library.names.json",
        "//host:host_params.textproto",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":reachy_host_lib",
        "//crates/reachy-edge:reachy_edge",
        "@brenn_reachy_crates//:serde_json",
        "@brenn_reachy_crates//:signal-hook",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

# A binary's root is its own crate, so the library's test target never sees the
# argument grammar, the lines this file renders, or the loop that owns the edge.
# The loop's cases bind ephemeral loopback ports and send real datagrams between
# them -- the destination a compiled script goes to is the one thing about the
# loop a test cannot otherwise see -- so they are not hermetic in the way the
# library's are. Nothing they bind is a fixed port and nothing leaves the
# machine.
rust_test(
    name = "reachy_host_bin_test",
    size = "small",
    crate = ":reachy_host",
    deps = [
        "//cogs:script_clk_rs",
        "//crates/motion-proto:motion_proto",
        ":reachy_host_lib",
    ],
)

# The configuration parse and the intent queue, both hermetic: messages built in
# memory, an injected instant, no socket and no clock. The one case that touches
# the filesystem establishes a path's absence.
rust_test(
    name = "reachy_host_test",
    size = "small",
    crate = ":reachy_host_lib",
)

# The voice pipeline's third-party closure, linked. Every other target in this
# package is pure Rust; this one pulls in OpenSSL and ONNX Runtime, which are
# native libraries the build supplies rather than the machine, and asks each one
# what version it is. It is the gate's proof that the closure links and that the
# `--cfg` flags `MODULE.bazel` states for the two crates whose discovery build
# scripts are switched off describe the library that actually got linked.
#
# All three brenn-pod crates are deps, not just the surface: the closure claim is
# that every native library any of them carries resolves, and a crate reached
# only through another's internal edges is a claim about that other crate's
# current dependency list rather than about this link.
rust_test(
    name = "host_closure_test",
    size = "small",
    srcs = ["tests/host_closure.rs"],
    edition = "2024",
    deps = [
        "@brenn_reachy_crates//:brenn-bridge",
        "@brenn_reachy_crates//:openssl",
        "@brenn_reachy_crates//:ort",
        "@brenn_reachy_crates//:speech-pipeline",
        "@brenn_reachy_crates//:speech-surface",
    ],
)

# The shipped configuration, read by the parser that will read it on the device.
# A separate crate from the library's own tests because it reads a file: it
# arrives through runfiles, and the environment variable names it beside the
# `data` attribute that supplies it. Nothing here needs the schema -- the parser
# carries its own copy, embedded at compile time.
rust_test(
    name = "shipped_params_test",
    size = "small",
    srcs = ["tests/shipped_params.rs"],
    data = [
        "//cogs:clip_library.names.json",
        "//host:host_params.textproto",
    ],
    edition = "2024",
    env = {
        "HOST_PARAMS": "host/host_params.textproto",
        "CLIP_NAMES": "cogs/clip_library.names.json",
    },
    deps = [
        ":reachy_host_lib",
        "//crates/reachy-edge:reachy_edge",
    ],
)
