#
# The harness's intent source: the wake gesture, or the library tour, through
# the real intent edge. It stands where the voice host stands -- outside the
# composition, holding the two loopback ports -- so a run's verdict covers the
# decode, the screens, the compile, the datagram and the timeline diff rather
# than a rehearsal of them.
#
# A binary and no library: everything it holds is about this one run, and
# `rust_test(crate = ...)` over a binary is how its own modules are tested.
#
# The emitted names sidecar is the production compile-time input: the harness
# stands its edge up without being handed a library, so the numbering its
# scripts carry is the numbering of the assets it was built beside -- library,
# sidecar and binary reach a unit as one payload. `$(execpath)` is what
# `include_str!` needs for a generated file in another package.
#
# The target name is the binary's name underscored: rules_rust derives the crate
# name from the target, and `reachy-ask` is not a Rust identifier.

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "reachy_ask",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//cogs:library.names.json"],
    edition = "2024",
    rustc_env = {
        "ASK_LIBRARY_NAMES": "$(execpath //cogs:library.names.json)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "//cogs:schedule_clk_rs",
        "//cogs:session_clk_rs",
        "//crates/motion-proto:motion_proto",
        "//crates/reachy-edge:reachy_edge",
        "//motion:reports_clk_rs",
        "//motion:timeline_clk_rs",
        "@brenn_reachy_crates//:serde_json",
        "@brenn_reachy_crates//:signal-hook",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

# The test-only greeting fixture is compile data for the `#[cfg(test)]` module;
# the gesture's shape and offsets, the tour's plan and budget, the engagement
# and the holds they have to cover, and the argument grammar. The compiles run
# in memory over an injected instant; what does bind a socket binds an ephemeral
# one -- a loopback listener standing in for the launcher's control API, and the
# narration port on 0 -- so two of these run side by side.
#
# `//cogs:scenario` and `//crates/reachy-motion:reachy_motion` are test
# dependencies and only that: the raise's offset has to cover the engagement,
# whose allowance scales with the machine's joint count, and then holds long
# enough for the
# latter's stillness watch to judge at its default settle and minimum. The
# binary links neither.
rust_test(
    name = "reachy_ask_test",
    size = "small",
    crate = ":reachy_ask",
    compile_data = [
        "fixtures/greeting.json",
        "fixtures/settle-evidence-1.json",
        "fixtures/settle-evidence-2.json",
    ],
    deps = [
        "//cogs:scenario",
        "//crates/reachy-motion:reachy_motion",
        "//crates/reachy-scratch:reachy_scratch",
    ],
)
