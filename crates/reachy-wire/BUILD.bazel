load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The wire codec, built for Bazel because every cog body that touches a driver
# channel parses bytes with it. Same sources Cargo builds from the manifest
# next door.
#
# `golden.json` is compile data rather than a runtime file: the crate pulls it
# in with `include_str!`, so both build lanes read one copy and neither needs a
# manifest directory or a runfiles path to find it. The Python checker takes the
# same file as a data dependency, which is what makes it a cross-language gate
# rather than two fixtures.
#
# The target name is the crate name, underscored: rules_rust derives the crate
# name from the target, and `reachy-wire` is not a Rust identifier.
rust_library(
    name = "reachy_wire",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["golden.json"],
    visibility = ["//visibility:public"],
)

# The layout this crate states is spoken by a driver process, a cog body and a
# Python checker, so it is checked in the lane that builds the cog too, not only
# in Cargo. Pure arithmetic over byte arrays: no I/O, no clock.
#
# `reachy_motion` is a dependency of the test and not of the library, mirroring
# the Cargo dev-dependency: one assertion compares the row count and mask bits
# stated here against the crate that owns `JointId`.
rust_test(
    name = "reachy_wire_test",
    size = "small",
    crate = ":reachy_wire",
    deps = ["//crates/reachy-motion:reachy_motion"],
)

# The vector file, exported so the Python checker can depend on the same copy
# the Rust codec asserts against.
exports_files(["golden.json"])
