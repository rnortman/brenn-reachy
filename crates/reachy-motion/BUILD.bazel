load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The motion layer: joint vocabulary, the envelope check, the trajectory shaper,
# and the per-tick control step a Clockwork cog body hosts.
#
# The target name is the crate name, underscored: rules_rust derives the crate
# name from the target, and `reachy-motion` is not a Rust identifier.
rust_library(
    name = "reachy_motion",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/reachy-kin:reachy_kin",
        "//hardware/dynamixel:registers_clk_rs",
        "//geometry:primitives_clk_rs",
        "//motion:arm_record_clk_rs",
        "//motion:bus_txn_clk_rs",
        "//motion:commission_clk_rs",
        "//motion:disarm_clk_rs",
        "//motion:engage_clk_rs",
        "//motion:faults_clk_rs",
        "//motion:timeline_clk_rs",
        "//motion:poll_clk_rs",
        "//motion:servo_health_clk_rs",
        "//motion:joints_clk_rs",
        "//motion:fk_clk_rs",
        "//motion:seq_clk_rs",
        "//motion:targets_clk_rs",
        "//motion:tick_state_clk_rs",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
        "@brenn_reachy_crates//:nalgebra",
        "@brenn_reachy_crates//:thiserror",
    ],
)

rust_test(
    name = "reachy_motion_test",
    # Hundreds of pure-arithmetic cases over the trajectory shaper and the tick;
    # no I/O, no clock, no sleep anywhere in the crate.
    size = "small",
    crate = ":reachy_motion",
)
