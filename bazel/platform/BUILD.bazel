# Our own copy of the pinned drop's host platform. Byte-equivalent to theirs,
# but owned here: their target has package-default visibility and so cannot be
# named from this repo, and `--host_platform` in .bazelrc must resolve.
platform(
    name = "host-clang",
    constraint_values = ["@bazel_tools//tools/cpp:clang"],
    parents = ["@platforms//host"],
)

# The Reachy Mini itself: 64-bit ARM Linux. Named by `--platforms` whenever
# anything is built for the device — the bench, the motion payload's two
# binaries — which is the only cross-compile here.
#
# Deliberately without host-clang's `@bazel_tools//tools/cpp:clang` constraint:
# nothing in the fetched Clockwork drop selects on it, and the drop's own
# toolchains declare os and cpu only, so on a target platform it would be dead
# weight.
#
# `make check-device` builds `:device_deployables` in this configuration and CI
# blocks on it, so a break here — a dependency without aarch64 in its
# `target_compatible_with`, a drop upgrade that stops registering the aarch64
# clang toolchain — is a red pull request rather than a discovery in front of a
# powered-up unit.
platform(
    name = "reachy-device",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# What a unit is built out of: the driver binary, the voice host, the executable
# both cog processes start from, the system target that emits their process
# descriptions and the writer's channel set, the launcher that starts them, the
# two launcher configs naming them, and the harness's intent source -- which the
# launcher does not start, because it binds the narration port before the
# composition comes up. tools/build-motion.sh builds this, so the payload it
# stages and the set the gate covers are one set.
#
# Two launcher configs, not one: the production config names the host and the
# audio device, and the harness twin names neither, because `deploy-motion.sh
# --run` starts the intent source itself -- a second process binding the
# narration port 7410 and addressing scripts to 7409 in one run is a bind race
# deciding the verdict -- and because a motion run must need no audio hardware.
# `//cogs:BUILD.bazel` states the rule at the rules.
#
# The launcher is C++ from the drop rather than anything of ours, so it is also
# what makes `make check-device` gate a cross-build of boost, protobuf and
# abseil for the device.
#
# The one shared object in the payload. The voice host links ONNX Runtime
# dynamically -- there is no static build to link -- so `libonnxruntime.so.1`
# has to sit beside the binary for the loader to find through its `$ORIGIN`
# runpath. Staged whether or not a unit runs the pipeline: a `NEEDED` entry is
# resolved at exec, not at first inference, so a host without it does not start
# at all.
#
# The wake and VAD weights, which are data and not deployables in any other
# sense: nothing links them, and the host loads them by the payload-relative
# paths its speech configuration names. They are fetched by digest rather than
# committed, so they are members here and nowhere in the tree.
#
# One payload member is not here and cannot be: `reachy_pod`, the audio device,
# is brenn-pod's binary -- it links libusb and libasound and is compiled in that
# repo's arm64 container -- so `tools/build-motion.sh` stages it from a prebuilt
# artifact and nothing in this build names it. This filegroup is what the gate
# cross-builds, and the pod binary's own gate is the repo that produced it.
#
# What is deployed and what a unit needs are not quite the same set, and the
# remaining difference is deliberate: the voice pipeline's own configuration
# names a site's speech services, its bus server and token, and a unit's link
# keys, so it is never content in this tree and cannot be a member here.
# `tools/build-motion.sh` stages whatever `REACHY_SPEECH_CONFIG` names at the
# path the launcher entry's `--speech-config` argument spells, and a payload
# built without one runs a host that narrates the session and does not listen.
filegroup(
    name = "motion_payload",
    srcs = [
        "//bazel/third_party/models:models",
        "//bazel/third_party/onnxruntime:shared_object",
        "//cogs:clockwork_prelaunch_sh",
        "//cogs:robot_clk_exe",
        "//cogs:robotcpu.textproto",
        "//cogs:robotcpu_harness.textproto",
        "//cogs:system_robot_clk",
        "//crates/reachy-ask:reachy_ask",
        "//crates/reachy-host:reachy_host",
        "//crates/reachy-motord:reachy_motord",
        "@clockwork//jewels/simplelaunch:simplelaunch",
    ],
    visibility = ["//visibility:public"],
)

# Everything cross-built for a unit, named once: what a unit runs today plus
# what is built for it and not yet staged. `make check-device` builds exactly
# this, so a target named here cannot be outside the gate, and there is nowhere
# else to add it. Membership here is a build claim, not a deploy claim --
# `motion_payload` above is the only place a *deployed* member is declared.
#
# One thing `make check-device` cross-builds is deliberately not here:
# `//crates/reachy-host:host_closure_test`, the only target that links OpenSSL
# and ONNX Runtime, and so the only proof that the voice pipeline's native
# libraries resolve for the unit's architecture. It is testonly, which this
# filegroup cannot carry, so the Makefile names it beside this one.
filegroup(
    name = "device_deployables",
    srcs = [
        ":motion_payload",
        "//crates/reachy-bench:reachy_bench",
    ],
    visibility = ["//visibility:public"],
)
