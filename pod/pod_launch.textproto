# The audio device's startup and app entries, merged into the launcher config
# `RobotCpu` renders (`cogs/robot.clk`) so one supervisor orders and runs them.
#
# Two messages of simplelaunch's `AppConfig`. Hand-written for the reason
# `driver/motord_launch.textproto` and `host/host_launch.textproto` are: the
# renderer only knows about Clockwork processes, and the pod is not one -- it is
# brenn-pod's binary, holding the mic array over USB and the board's ALSA
# devices, and it reaches this repo as a prebuilt artifact rather than as a
# target of this build.
#
# The executable is resolved against the launcher's working directory, which is
# the payload root -- so this is where `tools/build-motion.sh` stages the pod
# binary. The pre-launch step finishes the chip's USB reset before any launcher
# app commissions the servos. `run --chip-rebooted` then attaches without
# resetting the board again.
#
# The pod is given `--config conf/audio.conf`, relative to the payload root the
# launcher starts it in. That file is a payload member the build composes with
# brenn-pod's writer; it holds this unit's link key, and the payload already
# carries the unit's other secrets. A payload built with no speech configuration
# stages no link, and a pod started without its file parks and re-reads rather
# than exiting, so this app is safe to start there -- what it does then is wait,
# in its own console log.
#
# Named `pod` because that is this repo's word for the audio device, and the
# launcher spells each app's console `<name>_<run>.log`.
#
# Merged into the production and recording configs. The harness twin
# (`cogs:robotcpu_harness.textproto`) leaves both entries out: a motion run must
# need no audio hardware or speech services.
pre_launch {
  name: "pod_reboot_chip"
  executable: "reachy_pod"
  args: "reboot-chip"
}
app {
  name: "pod"
  executable: "reachy_pod"
  args: "run"
  args: "--chip-rebooted"
  args: "--config"
  args: "conf/audio.conf"
}
