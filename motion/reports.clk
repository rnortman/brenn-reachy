// What the session says happened: what a report is about, and why a script was
// refused.
//
// The narration vocabulary, written by the session as it goes -- one kind per
// thing worth saying, and one reason per script it declines. It is not the
// fault vocabulary next door and stands apart from it deliberately: a refusal
// is not a fault, nothing about the machine is wrong when it declines a script
// it cannot run, and a reader of a timeline row is asking a different question
// from a matcher on a raise.
//
// Two enums rather than two modules: a refusal reason travels as one of a
// report's numbers and never anywhere else, so the two are read by exactly the
// same code and change together.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::motion)]

// What a report is about.
//
// The session's narration vocabulary, and the tree's only statement of it: a
// report stands in the session's own ring as a timeline entry and crosses the
// process boundary as that row's bytes, so there is one numbering and nothing to
// hold together. The numbering is append-only -- a kind is never renumbered,
// because the number is what a recorded log and a running build have in common.
// What the numbers beside a report mean is stated per kind here, which is where
// a reader of a timeline row looks.
enum ReportKind
{
    uuid: 6499210d-3362-4d6c-bfd6-0f8dd663a1d5;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // Nothing was reported. What a never-written timeline row holds, and no
        // report any sender produces.
        #0 none default { underlying_value: 0; }

        // A phase was entered: `a` the phase entered, `b` the one left.
        #1 phase_changed { underlying_value: 1; }
        // A script passed the screen: `a` its id, `b` its step count, `detail`
        // the epoch the schedule it became was written under.
        #2 script_accepted { underlying_value: 2; }
        // A script was refused whole: `a` its id, `b` the refusal reason.
        #3 script_refused { underlying_value: 3; }
        // A fault was recorded: `a` the fault kind, `b` the servo it names as
        // the joint vocabulary numbers it -- zero where it names no single one,
        // which no bus row can say -- and `detail` the magnitude it was raised
        // on.
        #4 fault_recorded { underlying_value: 4; }
        // A response was selected: `a` the response, `b` the fault kind that
        // called for it.
        #5 response_taken { underlying_value: 5; }
        // A wind-down concluded: `a` the outcome, `b` non-zero for a park-class
        // disposition, `detail` the seconds of its one clock that were left
        // when it ended -- negative for a maneuver that ran past its deadline
        // instead of reaching the pose.
        #6 winddown_outcome { underlying_value: 6; }
        // Every row confirmed torque off. No numbers.
        #7 torque_off_confirmed { underlying_value: 7; }
        // Torque off went unconfirmed inside its budget: `a` the rows that did
        // not confirm, `detail` the seconds spent trying.
        #8 torque_off_unconfirmed { underlying_value: 8; }
        // The bus was declared failed: `a` the evidence's own detail, `detail`
        // the seconds since the last fresh sample.
        #9 bus_failure_declared { underlying_value: 9; }
        // The session ended at rest: `a` the script id it ended, `b` the joints
        // the release looked at and could not read, `detail` how far the joint
        // furthest from its stow angle was, radians. A machine found folded and
        // fully measured reads as an empty `b` and a deviation inside the
        // configured tolerance.
        #10 session_ended { underlying_value: 10; }
        // An aux transaction exhausted its retries: `a` its correlation number,
        // `b` the servo id, `detail` the seconds it waited.
        #11 aux_gave_up { underlying_value: 11; }
        // A schedule was published: `a` its epoch, `b` its step count.
        #12 schedule_published { underlying_value: 12; }
        // A group-scoped de-torque finished writing: `a` the response that
        // called for it, `b` the rows released.
        #13 degrade_released { underlying_value: 13; }
        // The commissioning survey refused the machine, which is the whole
        // reason a session parks out of starting: `a` the sequencer failure
        // kind, `b` the servo it names by bus id -- zero where the failure
        // names no single one -- and `detail` that kind's one headline number.
        // Which number that is, is the kind's: the status code a servo refused
        // with, the hardware-error bits it latched, the value a verified or
        // provisioned read gave back, the lowest supply reading, the count of
        // servos that did not answer, the model a servo claims, the angle that
        // places nothing, the first of the two numbers a solve failure carries
        // -- and zero for the failures whose evidence is that nothing came back
        // at all. It is a headline, not the verdict: the whole of it stays in
        // the session's state slot, where a live debugger reads it. Where the
        // kind is `verdict_unreadable` the slot itself did not read back, and
        // `detail` is the refusal's own small number instead -- which of the
        // ways a slot fails to name a failure this was.
        #14 commission_failed { underlying_value: 14; }
    }
}

// Why a script was refused.
//
// A refusal is all-or-nothing and it is a report, never a fault: nothing about
// the machine is wrong when it declines a script it cannot run. Every reason
// names a fact about the script or about the phase it arrived in, so a sender
// reading one knows whether to fix the script or to wait.
enum RefusalReason
{
    uuid: ce7cdd30-53f4-4820-b333-60fccac4d3c9;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // Not a refusal. What a never-written slot holds.
        #0 none default { underlying_value: 0; }
        // The machine is parked: nothing engages until an operator has been.
        #1 parked { underlying_value: 1; }
        // The machine is busy with a session. Scripts are never queued.
        #2 not_resting { underlying_value: 2; }
        // More steps than a schedule holds.
        #3 too_many_steps { underlying_value: 3; }
        // More overlay windows than a schedule holds.
        #4 too_many_overlays { underlying_value: 4; }
        // Times that are not a timeline: an offset that goes backwards, or a
        // duration that is not positive.
        #5 bad_times { underlying_value: 5; }
        // A motion index no library could hold. Whether this library holds one
        // is the mover's question at play time; this is the index that could
        // name no motion anywhere.
        #6 unknown_motion { underlying_value: 6; }
        // The datagram was not a script at all.
        #7 undecodable { underlying_value: 7; }
    }
}
