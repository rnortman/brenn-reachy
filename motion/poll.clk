// One sweep of the resting watch, as the slot holds it: which phase is running,
// which rows it covers, and what it has read.
//
// The poll sequencer writes both declarations here. Its own module rather than
// a corner of the commissioning one: the two sequencers share the readings in
// `motion/servo_health.clk` and the verdict forms in `motion/seq.clk`, and
// nothing else, so a phase added to either must not rebuild the other.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::motion)]

use motion::bus_txn;
use motion::joints;
use motion::seq;
use motion::servo_health;

// Which phase of a resting-watch sweep is running.
//
// Phases run from one for the same reason: zero is what nothing wrote, and the
// voltage sweep is a thing a poll would then go and do.
//
// Numbering is append-only; #1 is retired and will not be reused.
enum PollPhaseKind
{
    uuid: f6cb8316-20bf-42dc-a9b1-a45a1c7ddca2;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // No phase. What a slot nothing wrote holds.
        #0 none default { underlying_value: 0; }
        // The supply read of each named row.
        #2 voltage { underlying_value: 2; }
        // The hardware-error read of each named row.
        #3 health { underlying_value: 3; }
        // Finished: the next step hands back the rail.
        #4 complete { underlying_value: 4; }
        // Stopped: the next step hands back the failure.
        #5 failed { underlying_value: 5; }
    }
}

// One sweep of the resting watch, as the numbers a slot holds it between
// transactions.
//
// The poll sequencer's own state, read and written in place. The watch is the
// fallback the torque-on gate falls to: it re-reads the supply and the error
// byte of the rows the driver's health rotation has left stale, and hands back
// nothing else -- no pose, because the engagement pins at the angles the
// driver's own read returns. So this slot is what a sweep interrupted by a slot
// crossing resumes from, and never a verdict about anything.
// Numbering is append-only; #4, #6 and #7 are retired and will not be reused.
schema PollSnap
{
    uuid: e8c939dd-fb9b-459c-baa1-e54ef4c6dfd0;
    fields
    {
        // Which phase is running. `none` is what an unwritten slot holds.
        #0 phase: PollPhaseKind;

        // Where that phase's sweep stands. Zero in the two endings, refused past
        // the sweep's own length.
        #1 cursor: UInt32;

        // The verdict a failed phase hands back, `none` in every other phase.
        #2 failure: seq::SeqFailureSnap;

        // The transaction awaiting an answer.
        #3 pending: bus_txn::BusTxn;

        // The supply and error-bit readings this sweep has taken. A fresh
        // sweep starts from an empty snapshot, so a row this sweep does not
        // name reads back zero here and the caller merges by row rather than
        // taking the whole picture.
        #5 rail: servo_health::RailSnap;

        // The rows this sweep re-reads: the ones the driver's health rotation
        // has left older than the gate's staleness window, or has never
        // reached.
        #8 rows: joints::JointFlags;
    }
}
