# Bazel is the only build system here: every crate under crates/, every cog, and
# the cross-compiled device binary come out of this module. There are no Cargo
# manifests, no rustup, and no second lane -- one pinned compiler, one dependency
# resolution, one gate.
#
# Everything derived from the pinned Clockwork drop -- its whole dependency
# table, its toolchain registration -- is quarantined in the included segment,
# so that a drop upgrade touches one file and this one stays about us.

module(name = "brenn_reachy")

include("//bazel:clockwork_overrides.MODULE.bazel")

# The cog generator: the tool that turns a `.clk` module's cogs into Rust, and
# the crate the generated code rests on. It brings the Clockwork drop with it as
# its own dependency, which is why the override table above is a copy of theirs
# -- Bazel honours overrides only in the root module, so a dependency's table
# reaches nothing.
#
# Pinned by revision against the GitHub remote rather than by version: rusty-cogs
# publishes no releases and the module graph has to be fetchable by CI and by any
# other machine.
bazel_dep(name = "rusty_cogs", version = "")

git_override(
    module_name = "rusty_cogs",
    commit = "f21185e98359d31bba13d3199acd9f9a872015aa",
    remote = "https://github.com/rnortman/rusty-cogs.git",
)

# Uncomment to build against a working tree instead of the pin. Both must not be
# active at once; the pin above is what CI and every other machine resolve.
# local_path_override(
#     module_name = "rusty_cogs",
#     path = "../rusty-cogs",
# )

# The interpreter the drop pins for its own Python code and both of its pip
# hubs. Those hubs are version-keyed and the Clockwork compiler's dependency
# closure comes out of them, so anything of ours that imports the compiler runs
# on this version too. A fact supplied by the drop, revisited per drop, not a
# choice of ours.
PYTHON_VERSION = "3.10"

# The Clockwork compiler needs to know the name of the root module, and the
# extension that tells it can only see modules that use it -- so the root has to
# use it even though nothing here references the repo directly.
root_repo = use_extension("@clockwork//tools/repo:root_repo.bzl", "root_repo")
use_repo(root_repo, "root_repo")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = PYTHON_VERSION,
)

# Rust. The version has to be compatible with the versions the drop's override
# table forces on the whole graph, which is why it is here and not in that
# segment.
#
# An exact version, never a channel: this is the one compiler every crate here is
# built and linted with, on a workstation and on CI alike, and a floating channel
# would be a build nobody can reproduce. New lints therefore arrive when this pin
# is bumped, deliberately, and the churn they cause is absorbed in that commit.
bazel_dep(name = "rules_rust", version = "0.73.0")

RUST_VERSION = "1.97.1"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
# The edition must agree with the rustfmt edition flag in
# .claude/hooks/format.sh, or the editor hook formats against a different
# language version than the gate checks. This line is the edition's single
# statement.
rust.toolchain(
    edition = "2024",
    rustfmt_version = RUST_VERSION,
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The third-party Rust crates this repo needs, resolved by crate_universe.
# `from_specs` rather than `from_cargo` because there are no Cargo manifests to
# read: the specs below are this repo's single statement of what third-party code
# it depends on and at what version, and each carries a comment saying what it is
# for. MODULE.bazel.lock pins the resolution that comes out of them.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# f64 linear algebra for the head kinematics. reachy-kin and reachy-motion.
crate.spec(
    package = "nalgebra",
    version = "0.35",
)

# Derived `Display`/`Error` for the libraries' typed error enums, motion-proto's
# decode and validation refusals among them.
crate.spec(
    package = "thiserror",
    version = "2",
)

# JSON at runtime and in tests. motion-proto decodes the motion intent bodies
# that arrive on the wire; reachy-clips reads the clip assets; reachy-kin's baked
# linkage constants are asserted against the vendored copy of the vendor file
# they were transcribed from, and that file is JSON. `float_roundtrip` because
# that comparison is exact equality against transcribed decimals.
crate.spec(
    features = ["float_roundtrip"],
    package = "serde_json",
    version = "1",
)

# Serial port access for the servo bus, and the only I/O dependency here.
# Default features off drops the udev-backed enumeration support: the port is
# named in configuration, never discovered, so the extra native dependency would
# buy nothing and cost a build prerequisite. The floor is 4.9 because the bus
# layer's one-speaker guarantee rests on what an exclusive open does there:
# `TIOCEXCL` and a non-blocking exclusive `flock`, both held for the lifetime of
# the port. reachy-bus.
crate.spec(
    default_features = False,
    package = "serialport",
    version = "4.9",
)

# Error reporting at the binary edge only, where a chain of context is what an
# operator at a bench actually wants. Libraries use thiserror. reachy-bench,
# reachy-clips.
crate.spec(
    package = "anyhow",
    version = "1",
)

# Signal handling for the driver's stop gesture: SIGINT and SIGTERM set one
# atomic flag the loop thread reads, which is all the handler does. Taken as a
# dependency rather than written here because installing a handler is an `unsafe`
# syscall and every crate in this tree forbids unsafe code; `signal_hook::flag`
# is a safe wrapper over exactly that. reachy-motord, reachy-host, reachy-ask --
# the last two because a background child of a non-interactive shell inherits
# SIGINT ignored, so the handler is what makes a harness stop act at all.
crate.spec(
    default_features = False,
    package = "signal-hook",
    version = "0.3",
)

# Platform constants -- the two open(2) flags and the one errno the bus layer's
# contention probe reads. reachy-bus only, and constants only: every crate here
# forbids unsafe code, so nothing calls into it.
crate.spec(
    package = "libc",
    version = "0.2",
)

# Deserialization for the bench's configuration file, the clip assets, and the
# motion intent wire contract. `derive` because every one of those types is a
# plain struct with a `#[derive]` on it. reachy-bench, reachy-clips,
# motion-proto.
crate.spec(
    features = ["derive"],
    package = "serde",
    version = "1",
)

# The bench binary's configuration file format: the bus port and its baud, the
# arm thresholds the self-test registry reads, and the register values
# provisioning writes. Also the self-test record written beside that file.
crate.spec(
    package = "toml",
    version = "1",
)

# Dynamic Protobuf messages and the Protobuf text format, so the driver's
# configuration is parsed against the schema that generated it. `text-format`
# because that is the format the file is authored in; `prost` alone does not
# carry it. reachy-motord.
crate.spec(
    features = ["text-format"],
    package = "prost-reflect",
    version = "0.16",
)

# Pure-Rust Protobuf compilation: turns the generated `.proto` the driver embeds
# into the descriptor prost-reflect parses against. No protoc, no build-time
# native step, so the device cross-build needs nothing new. reachy-motord.
crate.spec(
    package = "protox",
    version = "0.9",
)

# The brenn-pod voice pipeline, which `reachy-host` composes. Three specs
# rather than the whole closure: a spec exists to produce a label, and these are
# the three the robot's host states its own wiring in. Everything the pipeline
# reaches through them is resolved by the same cargo run and pinned by the same
# lockfile, at the same revision, without a label of its own.
#
# `//crates/reachy-host:host_closure_test` names all three in their own right: a
# crate reached only through the surface's internal edges is proved to link only
# for as long as that edge exists.
#
# Git pins at a revision published on brenn-pod's public remote, never a local
# hash: a pin at an unpublished revision produces no lockfile, so the gate could
# not run. The dependency arrow is the ratified one -- brenn-reachy consumes
# brenn-pod, never the reverse. Move the three together; they are one workspace
# upstream and their internal path dependencies must agree.
#
# What this revision does not yet have: `speech_surface::Sinks` and
# `Server::with_sinks`, the seam a composition points at this repo's edge. The
# process that composes the pipeline cannot be written against this pin, so the
# revision moves with it (TODO(host-intent-producers)).
#
# At this revision `speech-surface` still takes `motion-proto` from inside
# brenn-pod, so the fetched closure carries a second copy of the wire contract
# beside `//crates/motion-proto` -- and a later revision points it at a
# historical brenn-reachy instead, which is a copy one publish behind this
# tree's. TODO(motion-proto-two-copies)
BRENN_POD_REV = "b943c21c43d4d32877968e1e0956a2491a18e0d4"

# The host library the robot's voice process is a composition of. reachy-host.
crate.spec(
    git = "https://github.com/rnortman/brenn-pod.git",
    package = "speech-surface",
    rev = BRENN_POD_REV,
)

# The pipeline stages the surface drives. Named here because the host states
# its own pipeline wiring. reachy-host.
crate.spec(
    git = "https://github.com/rnortman/brenn-pod.git",
    package = "speech-pipeline",
    rev = BRENN_POD_REV,
)

# The bus attachment crate, generic across the fleet and consumed here through
# the host's own driver: the robot attaches once, from the voice host.
crate.spec(
    git = "https://github.com/rnortman/brenn-pod.git",
    package = "brenn-bridge",
    rev = BRENN_POD_REV,
)

# The async runtime the voice host runs on. Quarantined to that binary -- the
# motion and control stack is sans-I/O and async-free. reachy-host.
crate.spec(
    features = [
        "fs",
        "io-std",
        "io-util",
        "macros",
        "net",
        "rt",
        "rt-multi-thread",
        "signal",
        "sync",
        "time",
    ],
    package = "tokio",
    version = "1",
)

# The inference backend the wake and VAD stages run on, and the TLS stack the
# pod link and the bus dial run on. Neither is called from this repo's own code;
# both are named so that `//crates/reachy-host:host_closure_test` can ask the
# linked libraries what they are, which is the only way a version pinned in a
# build file gets checked against the binary that resulted.
crate.spec(
    package = "ort",
    version = "=2.0.0-rc.12",
)

# Exactly, both of them, for the same reason `ort` is pinned exactly and a
# stronger one: the two annotations below transcribe these crates' build-script
# output by hand, and a missing `--cfg` is not an error -- it is silently false,
# compiling out whatever it guarded. A range would let a lockfile refresh move
# either crate to a version emitting a different set. `openssl-sys` is named
# only to pin it; nothing here links it directly.
crate.spec(
    package = "openssl",
    version = "=0.10.81",
)

crate.spec(
    package = "openssl-sys",
    version = "=0.9.117",
)

# OpenSSL is a Bazel dependency here, not a system one. The pod link is TLS-PSK,
# which is OpenSSL's, so the two crates that speak it cannot be swapped for a
# pure-Rust stack; what can be swapped is where the library comes from. The
# module graph already carries `openssl` (3.3.1, from the Clockwork drop's
# table) and builds it for both of this repo's platforms, so the two `-sys`
# build scripts -- which exist to find a system OpenSSL and report what they
# found -- are switched off and their findings stated here instead.
#
# The two cfg lists are what those scripts emit for 3.3.1, and they differ
# because the crates ask different questions of the same version. `osslconf` is
# the one configuration macro the drop's build sets that either crate looks for.
# `//crates/reachy-host:host_closure_test` asks the linked library its version,
# so a bump in that table reddens the gate rather than miscompiling: the cfg
# lists below are re-derived by hand when it does.
#
# They are bound to the crate versions as well as to OpenSSL 3.3.1, which is why
# both are pinned exactly above: the questions these scripts ask change between
# crate releases, and nothing asks the crate its version at runtime.
crate.annotation(
    crate = "openssl-sys",
    gen_build_script = "off",
    link_deps = [
        "@@//bazel/third_party/openssl:crypto",
        "@@//bazel/third_party/openssl:ssl",
    ],
    rustc_flags = [
        "--cfg=openssl",
        "--cfg=ossl101",
        "--cfg=ossl102",
        "--cfg=ossl102f",
        "--cfg=ossl102h",
        "--cfg=ossl110",
        "--cfg=ossl110f",
        "--cfg=ossl110g",
        "--cfg=ossl110h",
        "--cfg=ossl111",
        "--cfg=ossl111b",
        "--cfg=ossl111c",
        "--cfg=ossl111d",
        "--cfg=ossl300",
        "--cfg=ossl320",
        "--cfg=ossl330",
        "--cfg=osslconf=\"OPENSSL_NO_SSL3_METHOD\"",
    ],
)

crate.annotation(
    crate = "openssl",
    gen_build_script = "off",
    rustc_flags = [
        "--cfg=ossl101",
        "--cfg=ossl102",
        "--cfg=ossl110",
        "--cfg=ossl110g",
        "--cfg=ossl110h",
        "--cfg=ossl111",
        "--cfg=ossl111d",
        "--cfg=ossl300",
        "--cfg=ossl310",
        "--cfg=ossl320",
        "--cfg=ossl330",
        "--cfg=osslconf=\"OPENSSL_NO_SSL3_METHOD\"",
    ],
)

# ONNX Runtime the same way, and for a stronger reason: `ort-sys`'s build script
# downloads a prebuilt runtime over the network at build time, which no gate can
# reproduce and no sandbox permits. Switched off, and the runtime supplied as a
# Bazel dependency instead -- the release archives fetched below, one per CPU.
crate.annotation(
    crate = "ort-sys",
    gen_build_script = "off",
    link_deps = ["@@//bazel/third_party/onnxruntime:onnxruntime"],
)

crate.from_specs(name = "brenn_reachy_crates")
use_repo(crate, "brenn_reachy_crates")

# The ONNX Runtime the wake-word and VAD models are evaluated by, as Microsoft's
# own prebuilt linux release: headers and a shared object, one archive per CPU.
# `ort-sys` would otherwise fetch an equivalent at build time (see its
# annotation above); pinning the archives by hash makes the same library a
# reproducible input.
#
# 1.24.2 because that is the runtime the pinned `ort` release is built against;
# the two move together. Shared rather than static because a static build is not
# among the artifacts Microsoft publishes, which is why the deployed payload has
# to carry the library beside the binary.
# TODO(host-payload-membership)
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "onnxruntime_linux_x64",
    build_file = "//bazel/third_party/onnxruntime:onnxruntime.BUILD.bazel",
    sha256 = "43725474ba5663642e17684717946693850e2005efbd724ac72da278fead25e6",
    strip_prefix = "onnxruntime-linux-x64-1.24.2",
    urls = ["https://github.com/microsoft/onnxruntime/releases/download/v1.24.2/onnxruntime-linux-x64-1.24.2.tgz"],
)

http_archive(
    name = "onnxruntime_linux_aarch64",
    build_file = "//bazel/third_party/onnxruntime:onnxruntime.BUILD.bazel",
    sha256 = "6715b3d19965a2a6981e78ed4ba24f17a8c30d2d26420dbed10aac7ceca0085e",
    strip_prefix = "onnxruntime-linux-aarch64-1.24.2",
    urls = ["https://github.com/microsoft/onnxruntime/releases/download/v1.24.2/onnxruntime-linux-aarch64-1.24.2.tgz"],
)
