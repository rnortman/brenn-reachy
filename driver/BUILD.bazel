# Apache-2.0. The schemas the motor driver publishes and consumes: the pose it
# reads every cycle, the setpoint it is asked for, and what it reports about
# itself and the servos.
#
# A `.clk` module lives in a package named for the component that writes or
# publishes its types, and consumers import from there -- which is why these sit
# here rather than with the cog that happens to carry them. The directory is not
# `crates/reachy-driver/` because a module's `use` path and generated crate name
# are its path from the repo root verbatim, and a hyphen is legal in neither.
#
# One module per subject, because visibility is recompilation: the control path
# reads a pose every cycle and must not rebuild when the shape of a health
# reading changes.
#
# Nothing here depends on anything but `clockwork_rs` and sibling schema
# modules. No cogs, no runtime, no I/O.

load("@clockwork//clockwork:rules.bzl", "clk")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//bazel:clk_schema.bzl", "clk_schema_module")
load("//bazel:rust_clk.bzl", "rust_clk_module")

# The import lists are transitive and minimal: a module names every module
# reachable from it, and no more.
clk_schema_module(
    name = "pose",
    imports = [
        "//geometry:primitives",
        "//motion:joints",
    ],
)

# The process edge's own header, which no channel carries: a datagram is a
# schema's blob bytes with this in front.
clk_schema_module(name = "wire")

# The driver process's configuration, spelled out rather than through
# `clk_schema_module`, because it is the one module here that crosses the
# Protobuf backend -- which is what lets the numbers be authored as text -- and
# generation is declared per module.
clk(
    name = "motord_config_clk",
    srcs = ["motord_config.clk"],
    outs = [
        "motord_config_clk_cc.cc",
        "motord_config_clk_cc.hh",
        "motord_config_clk_cc.inl",
        "motord_config_clk_proto.proto",
        "motord_config_clk_proto_conv.cc",
        "motord_config_clk_proto_conv.hh",
        "motord_config_clk_proto_conv.inl",
    ],
    generate = [
        "cpp",
        "proto",
        "proto_conv",
    ],
    visibility = ["//visibility:public"],
)

rust_clk_module(
    name = "motord_config_clk_rs",
    src = "motord_config.clk",
)

# The numbers the driver ships with, read by the driver at startup and by the
# test that holds this file to the schema; and the driver's entry in the
# launcher's app table, which `cogs/robot.clk`'s `RobotCpu` merges into the
# launcher config it renders.
exports_files([
    "motord_launch.textproto",
    "motord_params.textproto",
])

clk_schema_module(
    name = "goal",
    imports = ["//motion:joints"],
)

clk_schema_module(
    name = "aux",
    imports = [
        "//hardware/dynamixel:registers",
        "//motion:bus_txn",
        "//motion:joints",
    ],
)

clk_schema_module(
    name = "gate",
    imports = [
        "goal",
        "//motion:joints",
    ],
)

clk_schema_module(
    name = "health",
    imports = [
        "//hardware/dynamixel:registers",
        "//motion:bus_txn",
        "//motion:joints",
    ],
)

# The value half of the wire pin: what a message of each edge-crossing schema
# looks like as bytes. The offset half is pinned by the generated crates' own
# const asserts, so what is left to hold is the encoding of the values.
rust_test(
    name = "golden_test",
    size = "small",
    srcs = ["golden_test.rs"],
    edition = "2024",
    deps = [
        ":goal_clk_rs",
        ":health_clk_rs",
        ":pose_clk_rs",
        ":wire_clk_rs",
        "//cogs:schedule_clk_rs",
        "//cogs:script_clk_rs",
        "//hardware/dynamixel:registers_clk_rs",
        "//motion:bus_txn_clk_rs",
        "//motion:joints_clk_rs",
        "//motion:reports_clk_rs",
        "//motion:timeline_clk_rs",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)
