// What the driver says about itself and about the servos: the edges it hits,
// what its rotating read of the status registers saw, and how one aux
// transaction turned out.
//
// Four records and the status vocabulary one of them speaks, in one module:
// all of it is the driver's diagnostic voice, none of it is per-cycle, and a
// consumer of one record is a consumer of the rest -- an operator report, a
// session's bookkeeping, a bench. The per-cycle pose stream is
// `driver/pose.clk` and stays out, so a change to a health record does not
// rebuild the control path.
//
// Three of the four are published when something happens; the fourth,
// `DriverStatus`, is published on a cadence and carries the whole run so far,
// because the driver is outside Clockwork and has no channel that retains
// anything for a reader who arrives late.
//
// The status an aux transaction ended with is declared here because the driver
// is what writes one: a producer owns the vocabulary its reports are read in,
// and a host that consumes an outcome imports the driver rather than the driver
// importing the host.
//
// Two conventions hold, and both are worth stating because a reader coming from
// the datagram layout will expect otherwise: an interval is a `Duration` and an
// instant a `SyncTime`, never a bare count of microseconds, and a set of servos
// is `JointFlags`, never a mask of bits a comment explains.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::driver)]

use hardware::dynamixel::registers;
use motion::bus_txn;
use motion::joints;

// Something the driver did, or refused to do, that is not visible in the pose
// stream.
//
// Events are per-occurrence, never per-cycle: a standing condition is a flag on
// the sample, and an event marks the edge that got it there.
enum EventKind
{
    uuid: e84e7947-0d98-4cd4-b664-e507e8fde8f0;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // Nothing happened: what a slot nothing wrote holds, and not an event a
        // driver ever publishes.
        #0 none default { underlying_value: 0; }

        // No goal arrived within the hold timeout, so the driver latched torque
        // off. `silence` is how long the goal stream was quiet.
        #1 hold_timeout_torque_off { underlying_value: 1; }

        // The driver wrote the minimum risk condition at startup.
        #2 startup_mrc_write { underlying_value: 2; }

        // A torque-off write was confirmed by every row it named.
        #3 torque_off_confirmed { underlying_value: 3; }

        // A torque-off write went unconfirmed by at least one row. `rows` names
        // the ones that did not confirm.
        #4 torque_off_unconfirmed { underlying_value: 4; }

        // A bus cycle did not run in its slot. `silence` is how late it was.
        #5 cycle_skipped { underlying_value: 5; }

        // A goal arrived with the queue full and was dropped. `count` is how
        // many were queued when it arrived.
        #6 goal_dropped_queue_full { underlying_value: 6; }

        // A goal arrived stale or out of order. It is executed anyway, in
        // arrival order; this says so. `silence` is how far past its instant it
        // arrived, and nothing for one that is merely out of order.
        #7 goal_stale_or_out_of_order { underlying_value: 7; }

        // The bus itself failed: a run of cycles where nothing answered at
        // all. `count` is that run, in cycles. `id` names no servo -- a bus
        // that answers nothing has no single failing one to name.
        #8 bus_failure { underlying_value: 8; }

        // What the last window of cycles cost, published on a fixed cadence
        // rather than on an edge -- the one kind here that is a measurement and
        // not an occurrence, because a grid that is being missed is a question
        // about the distribution and not about any one cycle. `work` is the
        // longest a cycle in the window took, `exchange` the longest its
        // out-of-band exchange took, `count` how many cycles the window held,
        // and `out_of_band` how many of them ran an out-of-band transaction at
        // all. A window is not made up for: a run that ends mid-window
        // publishes nothing for it.
        #9 cycle_stats { underlying_value: 9; }

        // An engagement took: every row it named read its torque-enable
        // register back as enabled, in the cycle that wrote it. `rows` names
        // them. A re-issue of an engagement whose rows are already believed
        // torqued says this again and writes nothing, so a lost answer heals
        // on the next re-issue.
        #10 engage_confirmed { underlying_value: 10; }

        // An engagement was written and at least one row did not read its
        // torque-enable register back as enabled. `rows` names the ones that
        // did not; the rest are believed torqued, and the driver's dead-man
        // runs over them like any other belief.
        #11 engage_unconfirmed { underlying_value: 11; }

        // An engagement was dropped without anything being written: no cycle
        // inside the request's window had a grouped read that answered every
        // row it named. `rows` names the ones the reads kept missing. The pin
        // is taken from the same read the cycle engages on, so a cycle that
        // cannot see a row does not take hold of it from an older reading.
        #12 engage_declined { underlying_value: 12; }
    }
}

// One thing the driver did, and the evidence for it.
//
// The evidence is four separate fields rather than one number whose meaning
// depends on the kind: an interval is an interval, a set of servos is a set, and
// which of them mean anything is stated per kind on `EventKind`. The fields a
// kind does not name are zero.
schema DriverEvent
{
    uuid: bf04f679-3588-4977-a494-1504ac789371;
    fields
    {
        // What happened.
        #0 kind: EventKind;

        // When it happened.
        #1 time: SyncTime;

        // How long the silence or the lateness the kind names was.
        #2 silence: Duration;

        // The servos the kind names, where it names a set of them.
        #3 rows: joints::JointFlags;

        // How many of whatever the kind counts.
        #4 count: UInt32;

        // The one servo the kind names, as its bus id. Zero where it names
        // none: a bus id is configuration, and the driver reports what it wrote
        // to rather than a row it inferred. Nothing counts with it -- what a
        // kind counts is `count`.
        #5 id: UInt8;

        // How long the cycle the kind names actually took, measured rather than
        // derived from the grid: `silence` on a skipped cycle is how late the
        // grid says the loop was, and this is what the cycle before it spent.
        // The two answer different questions and a report that carries only the
        // first cannot say why the slot was missed.
        //
        // Measured between two reads of a clock that can be stepped, so it can
        // come out negative. It is published as measured -- a negative span is
        // a time base that moved under the measurement, which is a reading
        // worth having and not one to round away.
        #6 work: Duration;

        // How long the out-of-band exchange the kind names took, measured the
        // same way and negative for the same reason. Its own field rather than
        // a second meaning for `silence`: what a cycle spent talking to one
        // servo out of band is not a silence and not a lateness, and a reader
        // that has to know the kind before it knows what an interval is has
        // stopped reading a record and started decoding a union.
        #7 exchange: Duration;

        // How many of the cycles a windowed kind counted ran an out-of-band
        // transaction. A second count, because a window has two: how many
        // cycles it held and how many of those did out-of-band work.
        #8 out_of_band: UInt32;

        // The longest single write call a windowed kind's cycles spent: the
        // host handing a request to the kernel and, on a draining port, waiting
        // for the bytes to leave the UART. Over every write the window's cycles
        // made -- the grouped read's request and the goal write on each of them,
        // plus the out-of-band request where one ran -- so it is not a part of
        // `exchange` and can exceed it or come off a cycle that ran no
        // out-of-band work at all. It is the part a host can do something
        // about: a window whose worst write is cheap while its worst exchange
        // is not points at the servo or the scheduler, and one whose write
        // carries the time points at the port.
        #9 drain: Duration;
    }
}

// One servo's health, as the driver's rotation read it.
//
// Per-servo and per-reading rather than a whole-machine summary: the rotation
// visits one servo at a time, and a report says what that visit saw. A host that
// wants the machine's picture keeps the latest report per servo.
schema HealthReport
{
    uuid: aa918466-6856-4cab-b342-d0efedd6e87a;
    fields
    {
        // Which servo, by bus id, for the reason `ServoHealthRow` states: bus
        // ids are configuration, and a reading filed under the wrong id sends
        // somebody to the wrong servo.
        #0 id: UInt8;

        // The servo's latched hardware-error byte as read. Bit 0 is the
        // input-voltage bit; interpreting the rest is the reading layer's
        // opinion, not this record's.
        #1 bits: UInt8;

        // Supply voltage at the servo, volts -- the units every threshold in
        // this stack is written in, so nothing downstream scales it.
        #2 volts: Float64;

        // Servo temperature, degrees Celsius. The hardware driver writes the
        // servo's own present-temperature cell as read, and publishes no report
        // at all when that read does not come back; the simulated driver models
        // nothing thermal and writes a constant of its model.
        #3 temp_c: Int8;

        // When the reading was taken.
        #4 sample_time: SyncTime;
    }
}

// How an aux transaction ended.
//
// Zero is `ok`, against the habit of leaving zero for "nothing wrote this": the
// transaction that ran without incident is the honest thing for a driver's
// freshly zeroed outcome to say it did. So a field of this type is only ever
// about a transaction some other field says happened.
//
// The numbering is append-only: it is what a recorded log and a running build
// have in common.
enum AuxStatus
{
    uuid: 3bea97c4-f9c1-4867-9e8a-0dcc18154d48;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // The servo answered, and the answer is in the payload.
        #0 ok default { underlying_value: 0; }
        // Nothing came back inside the driver's own window.
        #1 timeout { underlying_value: 1; }
        // Something came back and was not a reply.
        #2 decode_error { underlying_value: 2; }
        // The bus itself failed the transaction.
        #3 wire_error { underlying_value: 3; }
        // The driver declined to run it, so nothing reached the bus.
        #4 refused { underlying_value: 4; }
        // The servo answered with an error of its own. The code it gave is in
        // `value`.
        #5 servo_error { underlying_value: 5; }
        // A verified write read back as something else. What it read back is in
        // `value_kind` and `value`.
        #6 verify_mismatch { underlying_value: 6; }
        // The slot already held a request under another number; nothing
        // reached the bus. A decline of the request that arrived, and not a
        // judgement on it: `refused` is the driver saying the transaction
        // itself is not one it will run.
        #7 busy { underlying_value: 7; }
    }
}

// The driver's answer to exactly one aux transaction.
//
// `corr` is the join: a host matches an outcome to the request it issued and
// drops anything else, which is what makes re-issuing an unanswered request safe
// on a lossy transport.
schema AuxOutcome
{
    uuid: 1d61fb9c-90d1-45af-8b89-f6ce2c8bca4c;
    fields
    {
        // The correlation number of the request this answers.
        #0 corr: UInt32;

        // How it went. `ok` carries whatever answer the transaction had; the two
        // failures that carry evidence say so on their own values.
        #1 status: AuxStatus;

        // What shape the value below is, and `none` where the transaction
        // answered no register value -- a ping, a plain write, or a failure with
        // nothing to read back.
        #2 value_kind: registers::ValueShape;

        // The answer, as the eight bytes a register value is carried in read as
        // one little-endian number. Bits rather than a number of anything: what
        // they mean is `value_kind`, and an angle crosses here as its own
        // IEEE-754 pattern. Under `servo_error` it is the code the servo gave
        // instead, which is a number and not a register value, so `value_kind`
        // is `none`.
        #3 value: UInt64;

        // The model number a ping answered with, and zero for every other
        // transaction. Its own field rather than the value above because a ping
        // names no register, so there is no shape for the value to be tagged
        // with: what a ping proves is that something at this id answers, and
        // what it says about itself is this number.
        #4 model: UInt16;

        // Which transaction this answers, echoed from the request. An outcome
        // that carries only a correlation number is readable by the host that
        // issued the request and by nobody else -- a log whose record of the
        // requests is short holds outcomes nothing can identify. Echoing the
        // three fields that name the transaction makes an outcome say what it
        // is about on its own.
        #5 op: bus_txn::AuxOpKind;

        // Which servo the transaction named, as its bus id, echoed from the
        // request.
        #6 id: UInt8;

        // Which register the transaction named, or `none` where it named none,
        // echoed from the request.
        #7 reg: registers::RegId;
    }
}

// What the driver's seam counted: the datagrams that arrived and what was
// wrong with the ones it refused.
//
// Every field is cumulative since the process started, so a reader of one
// record is reading the whole run up to that record's instant.
schema SeamCounts
{
    uuid: 0c1cbd7a-4e26-4a6b-8bd1-0af38bcbbcc9;
    fields
    {
        // Datagrams queued for the loop thread.
        #0 queued: UInt64;

        // Goal setpoints that arrived.
        #1 goals: UInt64;

        // Session commands that arrived.
        #2 session_cmds: UInt64;

        // Datagrams whose length was not the schema's.
        #3 wrong_size: UInt64;

        // Datagrams of the right length that did not validate.
        #4 invalid: UInt64;

        // Datagrams dropped because the queue behind them was full.
        #5 overflowed: UInt64;

        // Datagrams the loop thread never took.
        #6 undelivered: UInt64;

        // Receives the operating system failed.
        #7 recv_errors: UInt64;

        // Reader threads that stopped, each one a port whose datagrams now
        // reach nothing.
        #8 readers_stopped: UInt64;
    }
}

// What the driver's cycles counted: what reached the servos, what did not, and
// what was turned away before it could.
//
// Cumulative since process start, for the reason `SeamCounts` states.
schema CycleCounts
{
    uuid: 2a3e4b95-0b60-4d97-9f9a-2f9b4a1e5f28;
    fields
    {
        // Goals that became the held setpoint and were written.
        #0 goals_executed: UInt64;

        // Goals refused because the queue was full.
        #1 goals_dropped: UInt64;

        // Times the dead-man latched torque off.
        #2 hold_timeouts: UInt64;

        // Rows that did not answer a grouped read, summed over cycles.
        #3 read_misses: UInt64;

        // Transactions the driver could not put on the wire, or could not
        // verify.
        #4 write_failures: UInt64;

        // Cycles in which the bus answered nothing at all.
        #5 blind_cycles: UInt64;

        // Events a cycle raised after it already had one to publish.
        #6 events_dropped: UInt64;

        // Host transactions turned away because another was pending, and
        // datagrams asking for nothing at all.
        #7 aux_refused: UInt64;

        // Delivery re-issues of the request already in the slot: the same
        // number carrying the same bytes.
        #8 aux_duplicates: UInt64;

        // Cycles that had an out-of-band transaction to run and no time left
        // to run it in.
        #9 aux_deferred: UInt64;

        // Health reports published.
        #10 health_reports: UInt64;

        // Health reads the machine did not answer, so no report went out.
        #11 health_misses: UInt64;

        // Confirmation read-backs the machine did not answer. Each one counts
        // as a row still holding torque.
        #12 confirm_misses: UInt64;
    }
}

// What the driver's loop counted: the grid it kept, the slots it missed, and
// the releases it wrote about the seam and the clock.
//
// Cumulative since process start, for the reason `SeamCounts` states.
schema LoopCounts
{
    uuid: 5f1cf0a2-6bd9-4d4a-9a97-cf9a4b2f7c14;
    fields
    {
        // Cycles run.
        #0 cycles: UInt64;

        // Grid points passed over without running, summed. Never made up for.
        #1 skipped: UInt64;

        // Times the process-start release was reported, which is once on every
        // run: the sweep is the process's first act on the bus, and the first
        // cycle is the earliest it can be said. Zero only in a copy composed
        // before that cycle, which no run publishes -- so on the wire this is
        // the driver saying it released the machine, and the instant it did is
        // `sweep_time` above.
        #2 startup_mrc: UInt64;

        // Cycles on which a stopped reader was answered with a release.
        #3 wire_failures: UInt64;

        // Datagrams taken off the seam and handed to a cycle.
        #4 taken: UInt64;

        // Times the clock stepped backwards, the machine was let go, and the
        // grid was re-drawn. Grid instants either side of one do not line up.
        #5 clock_steps: UInt64;
    }
}

// Everything the driver knows about its own run, republished periodically.
//
// Cumulative and complete: the newest record is the whole account of the run so
// far, so a reader that has only ever seen one of these has read the run. That
// is what it is for -- the driver is outside Clockwork and cannot retain
// anything on a channel, so the facts a run is verified from are republished
// rather than published once. A logger that attached late, or a datagram that
// was lost on the way, costs the log a copy and no fact.
//
// It carries what the driver's console summary line carries and what only the
// process itself observes: when it released the machine, which rows would not
// read back, and when it first published a sample and first heard from the host
// that commands it. Nothing here is a per-cycle measurement -- what a window of
// cycles cost is `DriverEvent`'s `cycle_stats`, which is an event and stays one.
schema DriverStatus
{
    uuid: 9c50ac1b-63be-4b70-9a2f-b1d51a7c8a30;
    fields
    {
        // When this record was composed.
        #0 time: SyncTime;

        // When the process wrote the minimum risk condition, which is the first
        // thing it does on the bus. Every record carries it, so a log that
        // missed the event stream's head still holds the instant.
        #1 sweep_time: SyncTime;

        // The rows whose verified torque-off write did not read back at that
        // sweep. Empty on a healthy start.
        #2 sweep_failed_rows: joints::JointFlags;

        // Whether the gate is standing in a torque-off latch: the sweep goes out
        // again on every cycle until a host arms the machine.
        #3 torque_latched: Bool;

        // When the driver published its first pose sample, and zero until it
        // has. Observed on the driver's own clock, so a host's ordering against
        // it is an ordering of two instants one process measured.
        #4 first_pose: SyncTime;

        // When the driver took the first session command off its inbox, and zero
        // until it has. Observed on the same clock as `first_pose`: a command
        // taken on or before the cycle that published the first sample is a host
        // that commanded the machine before the driver showed it one.
        #5 first_session_cmd: SyncTime;

        // What the seam counted.
        #6 seam: SeamCounts;

        // What the cycles counted.
        #7 cycle: CycleCounts;

        // What the loop counted.
        #8 loop_counts: LoopCounts;

        // Datagrams the driver put on the seam.
        #9 published: UInt64;

        // Sends the operating system refused. The report they carried is gone;
        // nothing is re-sent, because a stale sample on a dated stream is worse
        // than a missing one.
        #10 publish_failures: UInt64;

        // Whether this is the record a wind-down published on its way out.
        // False on every periodic copy, so a run whose last record says nothing
        // about a wind-down is a run that did not finish one.
        #11 wound_down: Bool;
    }
}
