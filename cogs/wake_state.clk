// What the wake cog keeps between executions: how many scripts it has published,
// which is also whether it has asked, and how many reports it could not read.
//
// A module of its own, as every state schema in this system is: a schema a slot
// is declared over has to be instantiated in a module the cog module imports,
// and holding it here keeps the cog module to cogs, channels and sockets.
//
// The count of scripts published is the whole of the cog's decision memory:
// there is one script per process and never another -- a refusal is final, per
// the rule against automatic recovery -- so a non-zero count is what makes a
// second execution know the first one happened. One field rather than a count
// beside a flag saying the same thing, because two fields for one fact are two
// fields able to disagree about whether the machine has been asked to move.
//
// The totals are held here rather than folded in the signal group: a group's
// fold restarts every time it reports, and these are absolute counts for the run.
//
// Nothing outside the wake cog reads or writes any of it, and both fields go
// when the intent bridge replaces that cog.
// TODO(reachy-pod-motion-integration)

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::cogs)]

// What the wake cog has asked for, and what it has counted.
schema WakeState
{
    uuid: 6bd9a1e4-2f5c-4d4a-9c3e-0d1b2a7f5c48;
    fields
    {
        // How many scripts went out. One, for a process that got as far as
        // commissioning; zero for one that did not, which is where a fresh
        // process begins. Whether the cog has asked is this being non-zero.
        #0 scripts_published: UInt64;

        // How many reports could not be read at all.
        #1 refused_reports: UInt64;
    }
}
