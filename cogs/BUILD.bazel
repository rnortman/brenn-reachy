# The online composition: the six sockets to the driver process, the box that
# closes the loop around the control core with them, the logger box that watches
# it, and the two processes that host them. No `cpp_cog` -- the module declares
# no cogs, because the Rust generator refuses a `udp_socket` and so the wake cog
# lives in `wake.clk`, and the logger's two cogs are the framework's own.
# `cpp_exe` synthesizes the one process executable both processes are started
# from, whose name is derived from the file stem and is therefore the name
# `robot.clk`'s `Process(executable=...)` spells.
#
# `online_main` rather than the offline main: the same `main`, whose
# `run_deterministic` is a refusing stub -- the right failure mode for a binary
# composed over live sockets.
#
# The generated `LogWriterConfig` the logger box binds is not among the `data`
# below and cannot be: it comes out of the system target, which depends on this
# rule. It is a deploy-time artifact, which is the framework's own arrangement
# for it too.
clk(
    name = "robot_clk",
    srcs = ["robot.clk"],
    outs = [
        "robot_clk_cc.cc",
        "robot_clk_cc.hh",
        "robot_clk_cc.inl",
        "robot_clk_exe.cc",
        "robot_clk_exe.hh",
        "robot_clk_exe.inl",
    ],
    cpp_deps = clk_module_deps(ROBOT_MODULES).cpp + [
        # The writer cogs' state is an extern type, so the executable needs the
        # header that declares it as well as the generated cog library.
        "@clockwork//clockwork/logging/writers:logger_cog_state",
    ],
    cpp_exe_deps = [
        # The configs arrive as protobuf text, so the executable carries the
        # generated protobuf messages and the conversions into the messages the
        # dials hand the cogs. Two of them are the framework's, read by the
        # logger box.
        ":config_clk_proto_cc_library",
        ":config_clk_proto_conv",
        "@clockwork//clockwork/logging/writers:channel_message_rates_config_clk_proto_cc_library",
        "@clockwork//clockwork/logging/writers:channel_message_rates_config_clk_proto_conv",
        "@clockwork//clockwork/logging/writers:logger_config_clk_proto_cc_library",
        "@clockwork//clockwork/logging/writers:logger_config_clk_proto_conv",
        "@clockwork//clockwork/scaffolding:online_main",
    ],
    # Read by path at process setup, relative to the runfiles of whatever runs
    # the executable. Named as a filegroup so the device payload stages the same
    # set.
    data = [":robot_config_files"],
    generate = [
        "cpp",
        "cpp_exe",
    ],
    visibility = ["//visibility:public"],
    deps = clk_module_deps(ROBOT_MODULES).clk + [
        # Generates nothing, so it has no other spelling: the channels the
        # logger publishes its own status on.
        "@clockwork//clockwork/logging/writers:logger_channels_clk",
    ],
)

# The configuration the online composition's processes read by path at setup,
# named once. `robot_clk` carries it as `data`, so a host-side `bazel run` finds
# it in the runfiles, and `tools/build-motion.sh` cqueries this same target to
# know what to stage into the device payload -- a config file added here reaches
# both, and there is nowhere else to add it.
filegroup(
    name = "robot_config_files",
    srcs = [
        "clip_library.textproto",
        "mover_params.textproto",
        "robot_logger.textproto",
        "robot_logger_rates.textproto",
        "session_params.textproto",
        "wake_params.textproto",
    ],
    visibility = ["//visibility:public"],
)

# The host smoke composition: the real control box, the simulated plant behind
# the real seam, a logger of its own, and the three processes that host them. No
# `cpp_cog` -- every cog in it belongs to another module -- and no Rust module at
# all, because the Rust generator refuses a `udp_socket` declaration and this
# module is mostly sockets. `cpp_exe` synthesizes the one executable all three
# processes are started from.
#
# `online_main` rather than the offline main, as the device composition does: the
# sockets are live, and a deterministic run over them would have nothing to read.
#
# The generated `LogWriterConfig` the host logger box binds is not among the
# `data` and cannot be: it comes out of the system target, which depends on this
# rule.
clk(
    name = "robot_host_clk",
