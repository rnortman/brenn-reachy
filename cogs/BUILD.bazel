# The motion cog system: the schemas everything here speaks, the cogs that run
# on the driver's sample stream, the session that says what the machine is doing,
# the simulated driver that produces the stream, and the process that hosts all
# four.
#
# Framework integration (compiling `.clk`, VarPacket round-trips, driving the
# deterministic runner from a Rust-authored log) is proved by `proof/`; not
# re-proved here. What this package adds is the composition: one box, one
# process, and scenarios that run it end to end.
#
# The rules below are in the order and the shape the drop's own BUILD updater
# renders, because a `clk()` over a system module brings a gate test that holds
# this file to exactly that. So they are alphabetical by target name rather than
# in dependency order, and the two rules the tool writes -- `system_sim_clk` and
# the `motioncpu.textproto` launcher config it derives -- carry no comments,
# because it strips them. That launcher config is used by nothing here: it
# redirects a child's console into files, which is not what a deterministic run
# wants. It earns its place when a system spans processes. Until then a wildcard
# build builds it and the TCP bridge it names for nothing, and the updater
# refuses the `tags = ["manual"]` that would stop that as surely as it refuses a
# comment. TODO(clockwork-build-updater-strips-annotations)

# The one system every scenario below runs on, and the generated artifacts the
# harness script needs on disk to run it. Named once so that a rename in the
# system module is one edit rather than five.
SIM_EXE = ":sim_clk_exe"

SIM_PROCESS = ":brenn_reachy.cogs.system_sim.motion_sim.proc.tachyon"

SIM_PUBLISHER_CONFIG = ":system_sim.motion_sim.MotionCpu_channel_publisher_config.tachyon"

SIM_LOGGER_CONFIG = ":system_sim.motion_sim.MotionCpu_event_logger_config.tachyon"

# The two the checkers are handed as well, to assert the run was configured the
# way the scenario is written for. The clip library is not among them: it rides
# in the executable's own runfiles, and no checker has anything to say about it.
SIM_CONFIGS = [
    "mover_params.textproto",
    "session_params.textproto",
    "sim_params.textproto",
]

# What each `.clk` module here reaches, transitively, written once per module and
# expanded by `clk_module_deps` into the four spellings a dependent target names
# it in -- the C++ library, the `.clk` compile, the generator's import path and
# the Rust crate. Each list is what its module imports plus what those imports
# reach, which is the import graph. The cog modules ride the mover chain:
# `motion` over `mover`, and `sim` over `motion` plus the plant. `session` is
# what the session keeps between executions, over the four sequencers and the
# narration; `script` is what arrives from outside and `session_cmd` the one
# datagram that goes to the driver, each deliberately narrow so that the driver
# side importing the command shape does not import the session's blast radius.
# The two state modules stand outside all of it -- the estimator's seed and the
# simulated plant are each imported by one cog module and nothing else -- so each
# names what it reaches on its own.
SESSION_MODULES = [
    "schedule",
    "//geometry:primitives",
    "//hardware/dynamixel:registers",
    "//motion:arm_record",
    "//motion:bus_txn",
    "//motion:commission",
    "//motion:disarm",
    "//motion:engage",
    "//motion:faults",
    "//motion:fk",
    "//motion:joints",
    "//motion:poll",
    "//motion:reports",
    "//motion:seq",
    "//motion:servo_health",
    "//motion:timeline",
]

SCRIPT_MODULES = ["schedule"]

SESSION_CMD_MODULES = [
    "//hardware/dynamixel:registers",
    "//motion:bus_txn",
]

# The mover's own chain, which meets the one above only at the cog module: what
# the mover keeps is the tick's state, the base and the overlay rows, and a
# schedule fact or two. Nothing the session keeps reaches any of it.
MOVER_MODULES = [
    "schedule",
    "//clips:player",
    "//geometry:primitives",
    "//motion:faults",
    "//motion:fk",
    "//motion:joints",
    "//motion:targets",
    "//motion:tick_state",
]

POSE_STATE_MODULES = ["//geometry:primitives"]

SIM_STATE_MODULES = [
    "//driver:aux",
    "//driver:gate",
    "//driver:goal",
    "//hardware/dynamixel:registers",
    "//motion:bus_txn",
    "//motion:joints",
]

MOTION_MODULES = MOVER_MODULES + [
    module
    for module in SESSION_MODULES
    if module not in MOVER_MODULES
] + [
    "config",
    "mover",
    "pose_state",
    "script",
    "session",
    "session_cmd",
    "//driver:goal",
    "//driver:health",
    "//driver:pose",
]

SIM_MODULES = MOTION_MODULES + [
    module
    for module in SIM_STATE_MODULES + ["//hardware/dynamixel:registers"]
    if module not in MOTION_MODULES
] + [
    "motion",
    "sim_state",
]

exports_files([
    "config.clk",
    "motion.clk",
    "mover.clk",
    "pose_state.clk",
    # The three-phase driver every scenario's `sh_test` runs, including the
    # harness proof's next door: one invocation of the deterministic runner for
    # the whole repo.
    "scenario_test.sh",
    "schedule.clk",
    "sim.clk",
    "sim_state.clk",
    "system_sim.clk",
])

# The configs, in a module of their own because they are the only schemas that
# cross the Protobuf backend -- which is what lets a box bind one to a file of
# text -- and generation is declared per module. Most of the vocabulary cannot
# cross it: the emitter refuses a negative enumerator, and the tracking-side enum
# mirroring the library's own has one.
clk(
    name = "config_clk",
    srcs = ["config.clk"],
    outs = [
        "config_clk_cc.cc",
        "config_clk_cc.hh",
        "config_clk_cc.inl",
        "config_clk_proto.proto",
        "config_clk_proto_conv.cc",
        "config_clk_proto_conv.hh",
        "config_clk_proto_conv.inl",
    ],
    generate = [
        "cpp",
        "proto",
        "proto_conv",
    ],
    visibility = ["//visibility:public"],
)

# No `cog_impl`: the module declares no cogs.
rust_clk_module(
    name = "config_clk_rs",
    src = "config.clk",
)

# The clip library asset's emitter, run as
# `bazel run //cogs:gen_clip_config -- --clips ... --out ... --names ...`, which
# is what `make clip-config` does with this package's own paths. Offline and
# host-side: it reads clip documents, not hardware.
rust_binary(
    name = "gen_clip_config",
    srcs = ["gen_clip_config.rs"],
    # The committed asset and the documents it comes from are embedded, so the
    # drift case below compares a fresh emit against the file without needing
    # runfiles or a working directory.
    compile_data = [
        "clip_library.names.json",
        "clip_library.textproto",
    ] + glob(["clips/*.json"]),
    edition = "2024",
    deps = [
        ":config_clk_rs",
        "//crates/reachy-clips:reachy_clips",
        "@brenn_reachy_crates//:anyhow",
        "@brenn_reachy_crates//:serde_json",
    ],
)

# A binary's root is its own crate, so the library's test target never sees the
# argument parsing, the printer, or the drift check against the committed asset.
rust_test(
    name = "gen_clip_config_test",
    size = "small",
    crate = ":gen_clip_config",
)

# Taking an output log apart, for whatever system wrote it: the binding check and
# a message to an owned value. Its own crate rather than a module of `scenario`,
# because the harness proof next door reads its logs the same way and must not
# depend on this system's schemas to do it.
rust_library(
    name = "log_read",
    srcs = ["log_read.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@rusty_cogs//crates/clockwork-logs:clockwork_logs",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

