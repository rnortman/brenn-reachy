        "//crates/reachy-motion:reachy_motion",
        "@brenn_reachy_crates//:thiserror",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

# In-crate because half of what is under test is private: the rows of the layer,
# and the delta crossing a player's frozen frame goes through.
rust_test(
    name = "overlay_test",
    size = "small",
    crate = ":overlay",
    # Only the cases need these: a fixture clip is authored as a document and
    # loaded the way the emitter loads one, so what plays is a real track, and
    # the refusal cases stamp an undeclared discriminant into the base's own
    # move, which is the wire form of the seed's vocabulary.
    deps = [
        ":config_clk_rs",
        "//crates/reachy-kin:reachy_kin",
        "//motion:tick_state_clk_rs",
        "@brenn_reachy_crates//:nalgebra",
        "@brenn_reachy_crates//:serde_json",
    ],
)

