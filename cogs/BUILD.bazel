    src = "schedule.clk",
)

# What arrives from outside: a script, as a request measured in offsets from the
# instant its sender stamped. It reaches only the schedule's own step and posture
# vocabulary, because what a step asks for is the same question either side of
# the screen.
# No `cog_impl`: the module declares no cogs.
clk_schema_module(
    name = "script",
    imports = SCRIPT_MODULES,
)

# What the session keeps between one execution and the next, in a module of its
# own because a cog member's type is an interface instantiation and the compiler
# resolves one only against a module the cog's module imports. It reaches the
# four sequencers, the narration and the schedule, which is why the driver side
# imports the command module next door instead.
# No `cog_impl`: the module declares no cogs.
clk_schema_module(
    name = "session",
    imports = SESSION_MODULES,
)

# The one datagram the session sends the driver. Narrow on purpose: the driver
# consumes it and must not rebuild when a sequencer snapshot or the timeline
# changes shape.
# No `cog_impl`: the module declares no cogs.
clk_schema_module(
    name = "session_cmd",
    imports = SESSION_CMD_MODULES,
)

