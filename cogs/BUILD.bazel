# The motion cog system: the schemas everything here speaks, the cogs that run
# on the driver's sample stream, the session that says what the machine is doing,
# the simulated driver that produces the stream, and the two processes that host
# them -- the deterministic one a scenario runs, and the wall-clock one a machine
# runs with sockets where that simulated driver is.
#
# Framework integration (compiling `.clk`, VarPacket round-trips, driving the
# deterministic runner from a Rust-authored log) is proved by `proof/`; not
# re-proved here. What this package adds is the composition: one box, one
# process, and scenarios that run it end to end.
#
# The rules below are in the order and the shape the drop's own BUILD updater
# renders, because a `clk()` over a system module brings a gate test that holds
# this file to exactly that. So they are alphabetical by target name rather than
# in dependency order, and the four rules the tool writes -- `system_sim_clk`
# and `system_robot_clk`, and the `motioncpu.textproto` and
# `robotcpu.textproto` launcher configs it derives -- carry no comments,
# because it strips them.
#
# `robotcpu.textproto` is the online run's launcher config, shipped in the device
# payload and consumed exactly as rendered: three apps -- the two cog processes
# and the driver, merged in through `RobotCpu`'s `simplelaunch_src` -- and
# upstream's prelaunch. `motioncpu.textproto` is used by nothing: it
# redirects a child's console into files, which is not what a deterministic run
# wants. A wildcard build builds it and the TCP bridge it names for nothing, and
# the updater refuses the `tags = ["manual"]` that would stop that as surely as
# it refuses a comment. TODO(clockwork-build-updater-strips-annotations)

# The one system every scenario below runs on, and the generated artifacts the
# harness script needs on disk to run it. Named once so that a rename in the
# system module is one edit rather than five.
SIM_EXE = ":sim_clk_exe"

SIM_PROCESS = ":brenn_reachy.cogs.system_sim.motion_sim.proc.tachyon"

SIM_PUBLISHER_CONFIG = ":system_sim.motion_sim.MotionCpu_channel_publisher_config.tachyon"

SIM_LOGGER_CONFIG = ":system_sim.motion_sim.MotionCpu_event_logger_config.tachyon"

# The two the checkers are handed as well, to assert the run was configured the
# way the scenario is written for. The clip library is not among them: it rides
# in the executable's own runfiles, and no checker has anything to say about it.
SIM_CONFIGS = [
    "mover_params.textproto",
    "session_params.textproto",
    "sim_params.textproto",
]

# What each `.clk` module here reaches, transitively, written once per module and
# expanded by `clk_module_deps` into the four spellings a dependent target names
# it in -- the C++ library, the `.clk` compile, the generator's import path and
# the Rust crate. Each list is what its module imports plus what those imports
# reach, which is the import graph. The cog modules ride the mover chain:
# `motion` over `mover`, and `sim` over `motion` plus the plant. `session` is
# what the session keeps between executions, over the four sequencers and the
# narration; `script` is what arrives from outside and `session_cmd` the one
# datagram that goes to the driver, each deliberately narrow so that the driver
# side importing the command shape does not import the session's blast radius.
# The two state modules stand outside all of it -- the estimator's seed and the
# simulated plant are each imported by one cog module and nothing else -- so each
# names what it reaches on its own.
SESSION_MODULES = [
    "schedule",
    "//geometry:primitives",
    "//hardware/dynamixel:registers",
    "//motion:arm_record",
    "//motion:bus_txn",
    "//motion:commission",
    "//motion:disarm",
    "//motion:engage",
    "//motion:faults",
    "//motion:fk",
    "//motion:joints",
    "//motion:poll",
    "//motion:reports",
    "//motion:seq",
    "//motion:servo_health",
    "//motion:timeline",
]

SCRIPT_MODULES = ["schedule"]

SESSION_CMD_MODULES = [
    "//hardware/dynamixel:registers",
    "//motion:bus_txn",
]

# The mover's own chain, which meets the one above only at the cog module: what
# the mover keeps is the tick's state, the base and the overlay rows, and a
# schedule fact or two. Nothing the session keeps reaches any of it.
MOVER_MODULES = [
    "schedule",
    "//clips:player",
    "//geometry:primitives",
    "//motion:faults",
    "//motion:fk",
    "//motion:joints",
    "//motion:targets",
    "//motion:tick_state",
]

POSE_STATE_MODULES = ["//geometry:primitives"]

SIM_STATE_MODULES = [
    "//driver:aux",
    "//driver:gate",
    "//driver:goal",
    "//hardware/dynamixel:registers",
    "//motion:bus_txn",
    "//motion:joints",
]

MOTION_MODULES = MOVER_MODULES + [
    module
    for module in SESSION_MODULES
    if module not in MOVER_MODULES
] + [
    "config",
    "mover",
    "pose_state",
    "script",
    "session",
    "session_cmd",
    "//driver:goal",
    "//driver:health",
    "//driver:pose",
]

# What the wake cog's module reaches: the request it publishes, the narration it
# reads, its own slot and its config.
WAKE_MODULES = [
    "config",
    "schedule",
    "script",
    "wake_state",
    "//geometry:primitives",
    "//motion:faults",
    "//motion:fk",
    "//motion:joints",
    "//motion:reports",
    "//motion:timeline",
]

# What the framework's logger box reaches: the two writer cogs, their extern
# state, the configuration they read and the status they publish. Named as
# modules so the four spellings come out of one list like everything else. The
# channels module is not among them because it generates nothing -- there is no
# `_clk_cc` for it -- so the `robot_clk` rule names it in `deps` alone.
LOGGER_MODULES = [
    "@clockwork//clockwork/logging:log_writer_config",
    "@clockwork//clockwork/logging/writers:channel_message_rates",
    "@clockwork//clockwork/logging/writers:channel_message_rates_config",
    "@clockwork//clockwork/logging/writers:logger",
    "@clockwork//clockwork/logging/writers:logger_config",
    "@clockwork//clockwork/logging/writers:logger_status",
]

# What the online composition reaches: the control core's whole chain, the two
# modules the wake gesture adds, and the logger box's own. No plant -- the
# driver's end of the wire is a process, not a modelled machine.
ROBOT_MODULES = MOTION_MODULES + LOGGER_MODULES + [
    "motion",
    "wake",
    "wake_state",
]

# What the host smoke composition reaches: everything the online one does, the
# online composition itself -- it nests the real `RobotBox` -- and the simulated
# plant's own chain, because on a workstation the far end of the seam is that
# plant rather than a process holding a serial port.
ROBOT_HOST_MODULES = ROBOT_MODULES + [
    module
    for module in SIM_STATE_MODULES + ["//hardware/dynamixel:registers"]
    if module not in ROBOT_MODULES
] + [
    "robot",
    "sim",
    "sim_state",
]

SIM_MODULES = MOTION_MODULES + [
    module
    for module in SIM_STATE_MODULES + ["//hardware/dynamixel:registers"]
    if module not in MOTION_MODULES
] + [
    "motion",
    "sim_state",
]

exports_files([
    "config.clk",
    "motion.clk",
    "mover.clk",
    "pose_state.clk",
    "robot.clk",
    "robot_host.clk",
    # The three-phase driver every scenario's `sh_test` runs, including the
    # harness proof's next door: one invocation of the deterministic runner for
    # the whole repo.
    "scenario_test.sh",
    "schedule.clk",
    "sim.clk",
    "sim_state.clk",
    "system_host.clk",
    "system_robot.clk",
    "system_sim.clk",
    "wake.clk",
    "wake_state.clk",
])

# The prelaunch script the rendered launcher config names, as an output of this
# package rather than as the external source file it is. The launcher runs it
# before the apps and resolves it against its working directory, so the device
# payload has to carry a copy at the path the config spells -- and a payload file
# has to be a path under `bazel-out` for the build script to find it, which an
# external source is not.
#
# What it does is `rm -rf /dev/shm/clockwork/pinion/pub/*`: the empty-namespace
# buffer layout every process in this system uses, so the hardcoded path is the
# right one here.
genrule(
    name = "clockwork_prelaunch_sh",
    srcs = ["@clockwork//clockwork/launch:clockwork_prelaunch.sh"],
    outs = ["clockwork_prelaunch.sh"],
    cmd = "cp -- $< $@",
    visibility = ["//visibility:public"],
)

# The configs, in a module of their own because they are the only schemas that
# cross the Protobuf backend -- which is what lets a box bind one to a file of
# text -- and generation is declared per module. Most of the vocabulary cannot
# cross it: the emitter refuses a negative enumerator, and the tracking-side enum
# mirroring the library's own has one.
clk(
    name = "config_clk",
    srcs = ["config.clk"],
    outs = [
        "config_clk_cc.cc",
        "config_clk_cc.hh",
        "config_clk_cc.inl",
        "config_clk_proto.proto",
        "config_clk_proto_conv.cc",
        "config_clk_proto_conv.hh",
        "config_clk_proto_conv.inl",
    ],
    generate = [
        "cpp",
        "proto",
        "proto_conv",
    ],
    visibility = ["//visibility:public"],
)

# No `cog_impl`: the module declares no cogs.
rust_clk_module(
    name = "config_clk_rs",
    src = "config.clk",
)

# What one run of the motion system did, read off its log: the operator's tool
# for judging a hardware run. Run as
# `bazel run //cogs:first_motion_report -- <log-dir>`, or over a log pulled off
# a unit.
#
# It reads the channel set both systems declare, which is what lets the test
# below prove it against a deterministic run with no hardware log at all.
rust_binary(
    name = "first_motion_report",
    srcs = ["first_motion_report.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":log_read",
        ":motion_channels",
        ":motion_slots",
        ":schedule_clk_rs",
        ":script_clk_rs",
        ":session_clk_rs",
        ":session_cmd_clk_rs",
        "//crates/dxl-proto:dxl_proto",
        "//crates/reachy-driver:reachy_driver",
        "//crates/reachy-kin:reachy_kin",
        "//crates/reachy-motion:reachy_motion",
        "//driver:goal_clk_rs",
        "//driver:health_clk_rs",
        "//driver:pose_clk_rs",
        "//hardware/dynamixel:registers_clk_rs",
        "//motion:bus_txn_clk_rs",
        "//motion:faults_clk_rs",
        "//motion:joints_clk_rs",
        "//motion:reports_clk_rs",
        "//motion:seq_clk_rs",
        "//motion:timeline_clk_rs",
        "@brenn_reachy_crates//:nalgebra",
        "@rusty_cogs//crates/clockwork-logs:clockwork_logs",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

# The analyzer over a real run of the system it is written for: S1's own three
# phases, with this binary in the checker's position. S1 performs the wake
# gesture the report is about -- commission, engage, raise, hold, stow, release
# -- so a green run here is the analyzer proven end to end against a log the
# system actually wrote, which is the only way to prove it before a unit is
# available.
#
# The harness script's own invocation, not a second one: the analyzer takes a log
# directory and nothing else, so it fits the checker slot with no extra
# arguments.
#
# This proves the analyzer over one of the two log formats: a deterministic run
# writes offboard `.slog` files, and the online logger writes onboard `.olog`
# ones. The other format is exercised by `make motion-host-run`, which starts the
# online system on this machine and runs this same binary over what its writer
# wrote -- a manual target, and the only place the onboard path is read.
sh_test(
    name = "first_motion_report_over_s1_test",
    size = "small",
    srcs = ["scenario_test.sh"],
    args = ["first_motion_report"] + [
        "$(rootpath %s)" % label
        for label in [
            ":s1_author",
            SIM_EXE,
            SIM_PROCESS,
            SIM_PUBLISHER_CONFIG,
            SIM_LOGGER_CONFIG,
            ":first_motion_report",
        ]
    ],
    data = [
        ":first_motion_report",
        ":s1_author",
        SIM_EXE,
        SIM_LOGGER_CONFIG,
        SIM_PROCESS,
        SIM_PUBLISHER_CONFIG,
    ],
)

# A binary's root is its own crate, so the library targets never see the
# reading, the checks or the printer.
#
# The two online systems' logging policies ride in as runfiles: the analyzer
# restates which channels are retained, and one case reads the policies back to
# say the restatement is what they declare.
rust_test(
    name = "first_motion_report_test",
    size = "small",
    crate = ":first_motion_report",
    data = [
        "system_host.clk",
        "system_robot.clk",
    ],
    env = {
        "SYSTEM_ROBOT_CLK": "cogs/system_robot.clk",
        "SYSTEM_HOST_CLK": "cogs/system_host.clk",
    },
)

# The clip library asset's emitter, run as
# `bazel run //cogs:gen_clip_config -- --clips ... --out ... --names ...`, which
# is what `make clip-config` does with this package's own paths. Offline and
# host-side: it reads clip documents, not hardware.
rust_binary(
    name = "gen_clip_config",
    srcs = ["gen_clip_config.rs"],
    # The committed asset and the documents it comes from are embedded, so the
    # drift case below compares a fresh emit against the file without needing
    # runfiles or a working directory.
    compile_data = [
        "clip_library.names.json",
        "clip_library.textproto",
    ] + glob(["clips/*.json"]),
    edition = "2024",
    deps = [
        ":config_clk_rs",
        "//crates/reachy-clips:reachy_clips",
        "@brenn_reachy_crates//:anyhow",
        "@brenn_reachy_crates//:serde_json",
    ],
)

# A binary's root is its own crate, so the library's test target never sees the
# argument parsing, the printer, or the drift check against the committed asset.
rust_test(
    name = "gen_clip_config_test",
    size = "small",
    crate = ":gen_clip_config",
)

# The configuration the host composition's three processes read by path at setup,
# named once. `robot_host_clk` carries it as `data`, so a `bazel run` finds it in
# the runfiles, and `tools/host-motion-run.sh` cqueries this same target to know
# what to stage into its scratch tree.
#
# It is the device set with two substitutions: the plant reads the scenarios'
# `sim_params.textproto`, and the logger reads a host log root instead of a
# device one. Everything else is the file a unit runs on, which is the whole
# point of the exercise.
filegroup(
    name = "host_config_files",
    srcs = [
        "clip_library.textproto",
        "host_logger.textproto",
        "mover_params.textproto",
        "robot_logger_rates.textproto",
        "session_params.textproto",
        "sim_params.textproto",
        "wake_params.textproto",
    ],
    visibility = ["//visibility:public"],
)

