# Taking an output log apart, for whatever system wrote it: the binding check and
# a message to an owned value. Its own crate rather than a module of `scenario`,
# because the harness proof next door reads its logs the same way and must not
# depend on this system's schemas to do it.
rust_library(
    name = "log_read",
    srcs = ["log_read.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@rusty_cogs//crates/clockwork-logs:clockwork_logs",
        "@rusty_cogs//crates/clockwork-rs:clockwork_rs",
    ],
)

# The format dispatch's own cases: the onboard skip in both directions, the same
# absence over an offboard log, and a directory holding no log at all. The logs
# are written by the framework's own writers into a scratch directory, because a
# hand-built file would be this repo's idea of the format rather than the format.
rust_test(
    name = "log_read_test",
    size = "small",
    crate = ":log_read",
)

# What this system's channels are called, and nothing else. Its own crate because
# the operator's report and the scenario harness both name the same channels and
# must not reach each other's crates to do it: a rename that lands in one Rust
# spelling and not the other is a channel reported missing at the top of a
# report.
rust_library(
    name = "motion_channels",
    srcs = ["motion_channels.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
)

