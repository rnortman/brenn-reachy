# What the mover cog keeps between executions, in a module of its own: the
# tick's state, the base it composes over, and the overlay rows. A schedule edit
# and a tick-state edit are different subjects and neither should rebuild the
# other's consumers, which is why this is a module of its own.
clk(
    name = "mover_clk",
    srcs = ["mover.clk"],
    outs = [
        "mover_clk_cc.cc",
        "mover_clk_cc.hh",
        "mover_clk_cc.inl",
    ],
    cpp_deps = clk_module_deps(MOVER_MODULES).cpp,
    generate = ["cpp"],
    visibility = ["//visibility:public"],
    deps = clk_module_deps(MOVER_MODULES).clk,
)

# No `cog_impl`: the module declares no cogs.
rust_clk_module(
    name = "mover_clk_rs",
    src = "mover.clk",
    imports = clk_module_deps(MOVER_MODULES).imports,
    deps = clk_module_deps(MOVER_MODULES).rs,
)

# The overlay layer of the decision tick: the window screen, the players, and the
# base a composed setpoint rides on. Its own crate rather than a module of the cog
# bodies, because the cog and its cases read the same player rows and must read
# them the same way.
rust_library(
    name = "overlay",
    srcs = ["overlay.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":mover_clk_rs",
        ":schedule_clk_rs",
        "//clips:player_clk_rs",
