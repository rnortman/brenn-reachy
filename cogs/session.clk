// What the session cog is, between one execution and the next: which phase the
// machine is in, the state it wakes up into, and the one aux transaction it is
// waiting on.
//
// The state sits in a module of its own, apart from the cog that keeps it. That
// is forced rather than stylistic: a cog member's type is an interface
// instantiation, and the compiler resolves one only against a module the cog's
// module imports.
//
// The aux bookkeeping sits here rather than in a module beside it because every
// consumer of one is a consumer of the other: the session host writes the
// pending transaction as part of the same slot it reads its phase back from.
// The vocabulary the driver answers with -- how a transaction ended -- is the
// driver's own, in `driver/health.clk`.
//
// One convention holds throughout, and it is worth stating because a reader
// coming from the wire format will expect otherwise: time is `SyncTime` and
// `Duration`, never a bare nanosecond count. The wire format carries `i64`
// nanoseconds because a datagram has no type system; a Clockwork message does,
// and a raw count here would throw that away at the one boundary where it is
// free to keep.
//
// What a sequence is and how it stopped is `motion/seq.clk`. Faults are
// `motion/faults.clk`, what a report is about and why a script was refused is
// `motion/reports.clk`, and the two
// halves of an episode -- one timeline row, and the maneuver being run while the
// story is told -- are `motion/timeline.clk`, imported under an alias because
// `SessionState` carries a field called `timeline`.
//
// Each of the four sequencers keeps its phases and its
// state in a module of its own -- `motion/commission.clk`, `motion/poll.clk`,
// `motion/engage.clk`, `motion/disarm.clk` -- over the record they bracket an
// arming with, `motion/arm_record.clk`. The four are imported under aliases
// here because `SessionState` carries a field named after each of them.
//
// What a session plans is `cogs/schedule.clk`, imported under an alias because
// `SessionState` carries a field called `schedule`. Angles are radians about
// the model datum and positions metres in the body frame wherever an imported
// schema carries one, the units `reachy-kin` and `reachy-motion` use, so
// nothing here converts.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::motion)]

use cogs::schedule as schedule_vocab;
use hardware::dynamixel::registers;
use motion::bus_txn;
use motion::commission as commission_vocab;
use motion::disarm as disarm_vocab;
use motion::engage as engage_vocab;
use motion::joints;
use motion::poll as poll_vocab;
use motion::seq;
use motion::timeline as timeline_vocab;

// Which phase of a session the machine is in.
//
// The phases are the machine's whole life, in the order it lives them, and the
// numbering is that order. Two of them are endings and the difference between
// them is the doctrine's: `resting` is a session that finished, and the next
// accepted script is a new engagement; `parked` is latched and only an operator
// restarting the process leaves it.
enum SessionPhase
{
    uuid: 874344e9-a38f-4074-96ca-c6b781ccfa7e;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // Nothing has run yet. What a never-written slot holds, and where the
        // first execution begins commissioning from.
        #0 starting default { underlying_value: 0; }
        // Commissioned, de-torqued, waiting for a script.
        #1 resting { underlying_value: 1; }
        // Arming: torque, gains, goals pinned.
        #2 engaging { underlying_value: 2; }
        // Under command: the schedule is published and the tick is streaming.
        #3 active { underlying_value: 3; }
        // A response with a stow maneuver is running.
        #4 winding_down { underlying_value: 4; }
        // Releasing: stow verified, torque written off.
        #5 stopping { underlying_value: 5; }
        // Latched. Nothing engages until an operator has been.
        #6 parked { underlying_value: 6; }
    }
}

// The one aux transaction the session is waiting on, or that it is waiting on
// none.
//
// One and not a queue: the session is strictly serial by construction -- a
// sequencer hands out one transaction at a time and is stepped again when the
// answer comes back -- and the driver refuses a second outstanding request
// loudly rather than buffering it. So the slot holds exactly what a re-issue
// needs: the datagram's own fields, when it went out, and how many times it has.
//
// The request is held field for field rather than as encoded bytes. A re-issue
// must be the same datagram, correlation number included, and rebuilding it from
// the fields is the same encode the first one went through -- where a stored
// datagram would be a second representation able to disagree with the fields
// beside it.
schema AuxPending
{
    uuid: 5b9d7fc8-9da7-4d0e-aece-9a2751d14357;
    fields
    {
        // Whether a transaction is outstanding. Every field below means nothing
        // when this is false, and the zero operation is what a slot nothing
        // wrote holds.
        #0 active: Bool;

        // The correlation number the request went out with, and the only thing
        // that matches an outcome to it. A re-issue keeps it, so a late
        // duplicate of an answered request is recognisable as one.
        #1 corr: UInt32;

        // Which transaction it is.
        #2 op: bus_txn::AuxOpKind;

        // Which servo, as its bus id.
        #3 id: UInt8;

        // Which register, or `none` where the transaction concerns none. Not a
        // servo address: the address table lives below the wire line, in the
        // driver's bus layer.
        #4 reg: registers::RegId;

        // What shape the value below is.
        #5 value_kind: registers::ValueShape;

        // The value, as the eight bytes the wire carries it in read as one
        // little-endian number. Bits rather than a number of anything: what they
        // mean is `value_kind`, and an angle crosses here as its own IEEE-754
        // pattern.
        #6 value: UInt64;

        // When the request was last put on the wire. What the timeout is
        // measured from, so a re-issue restarts it.
        #7 issued: SyncTime;

        // How many times it has been re-issued. The budget is configured; past
        // it, the sequencer is handed a silence and fails the sequence itself.
        #8 retries: UInt32;
    }
}

// Everything the session is, between one execution and the next.
//
// The session cog is woken by five message classes and by a lapse, so it runs at
// no fixed rate and every wake begins by reading this slot back. What lives here
// is therefore everything that is not handed to it read-only: which phase it is
// in, the schedule it published, the sequence it is driving and where that
// sequence stands, the transaction it is waiting on, the maneuver it may be
// running, the rows a degrade still owes a torque-off write, the two watchdog
// anchors, the report timeline, and the run's totals.
//
// The four sequencer snapshots are four fixed slots rather than one, because
// there is no union in this language: `seq_kind` names
// which of them describes a live sequence and the other three are whatever the
// last sequence of their kind left. Only one sequence runs at a time, always --
// a commission, then an engagement, then a release -- so the cost is bytes and
// what it buys is a restore that cannot read one sequence's numbers as another's.
//
// The schedule is held here as well as published. `ScheduleChan` is latest-wins
// and this cog is its only publisher, so the copy here is the authority on what
// was asked for: a republish on any change is written from this field, and
// nothing else reads the channel back.
//
// Numbering is append-only; #20 and #21 are retired and will not be reused.
schema SessionState
{
    uuid: 5e79f353-ae2a-4fde-a452-989a253ef1a8;
    fields
    {
        // Which phase the machine is in. `starting` is the default, which is
        // also what a never-written slot holds -- so a first execution needs no
        // flag to know it is the first.
        #0 phase: SessionPhase;

        // The schedule as last published, whether or not anything is engaged.
        #1 schedule: schedule_vocab::SessionSchedule;

        // The id of the script the schedule was built from, and zero before any
        // script has been accepted. Carried so a report about the session names
        // the script that asked for it.
        #2 script_id: UInt32;

        // Which sequencer is being driven over the aux path, or none. This names
        // which of the four snapshots below describes a live sequence.
        #3 seq_kind: seq::SeqKind;

        // The commissioning, as the last one left it.
        #4 commission: commission_vocab::CommissionSnap;

        // The resting watch, likewise.
        #5 poll: poll_vocab::PollSnap;

        // The engagement, likewise.
        #6 engage: engage_vocab::EngageSnap;

        // The release, likewise.
        #7 disarm: disarm_vocab::DisarmSnap;

        // The instant a sequencer asked to be stepped again at, meaningful while
        // one is waiting. A wake at or past it resolves the wait; the wake floor
        // is what guarantees there is one.
        #8 wait_deadline: SyncTime;

        // The aux transaction outstanding, or that none is.
        #9 aux: AuxPending;

        // The wind-down running, or that none is.
        #10 winddown: timeline_vocab::WindDownSnap;

        // Whether a torque-off has been commanded and not yet confirmed. While
        // it stands, every wake republishes the command: the datagram is
        // idempotent and the transport is lossy, and nothing gates de-torquing.
        #11 torque_off_pending: Bool;

        // When the confirmation budget for that command is spent. Past it the
        // session reports the de-torque unconfirmed and keeps commanding it --
        // the budget bounds the reporting, never the commanding.
        #12 torque_off_deadline: SyncTime;

        // The nominal instant of the freshest sample seen. What the staleness
        // watchdog measures from.
        #13 last_sample_time: SyncTime;

        // Whether any sample has ever been seen. Which arm of the freshness
        // watchdog applies: before the first sample it is the startup grace, and
        // after it the staleness window.
        #14 saw_sample: Bool;

        // When the session's first execution ran. The startup grace is measured
        // from it.
        #15 started_at: SyncTime;

        // Whether `started_at` names an instant the session ran at. A zero
        // instant is a legitimate one under a deterministic runner, so the
        // anchor needs a flag exactly as the sample anchor beside it does.
        #16 started: Bool;

        // The report timeline: a ring of sixty-four, holding the whole story
        // rather than the part of it still waiting to go out. The message that
        // carries it carries every row, so nothing is drained out of here --
        // what leaves the ring leaves it because a newer row needed the room.
        #17 timeline: FixedArray<timeline_vocab::TimelineEntry, 64>;

        // How many reports have been appended, all run, modulo the count's own
        // width. The row a report is written to is this number modulo the ring's
        // length, and the width is a whole number of ring lengths so the
        // arithmetic survives the wrap.
        #18 timeline_head: UInt8;

        // How many rows were dropped off the front of *this* ring to make room.
        // It is also what says whether the ring has wrapped: nothing has been
        // dropped exactly while the story is shorter than the ring, so a head
        // past the ring's length with nothing dropped is a slot describing a
        // ring that never existed. Cleared with the rows, because a ring that
        // holds no story has dropped none of it -- which is what makes this the
        // number a published story carries and `reports_dropped` below the
        // lifetime one.
        #19 timeline_dropped: UInt32;

        // The correlation number the next aux request carries. Monotonic, so a
        // late duplicate of a request already answered is recognisable as one.
        #22 next_corr: UInt32;

        // How many scripts passed the screen, all run.
        #23 scripts_accepted: UInt64;

        // How many were refused, all run. Every refusal is also a report naming
        // its reason; this is the total a reader compares those against.
        #24 scripts_refused: UInt64;

        // How many faults were recorded, all run, from all three kinds of
        // evidence: the tick's raises, the driver's events, and the error bits a
        // health report carried.
        #25 faults_recorded: UInt64;

        // How many responses were selected, all run. Not equal to the faults
        // recorded: a fault raised while a maneuver is already running re-ranks
        // that maneuver rather than starting a second one.
        #26 responses_taken: UInt64;

        // How many aux datagrams were put on the wire a second or later time,
        // all run. Delivery retry and never a perturbed input: a re-issue is the
        // same datagram, correlation number included.
        #27 aux_retries: UInt64;

        // How many aux transactions exhausted their retries, all run. Each one
        // was handed to the sequencer as a silence, and the sequencer decided
        // what it meant.
        #28 aux_failures: UInt64;

        // How many story datagrams went out, all run. One per execution that
        // added a row, and each one carries the whole story rather than the row
        // that prompted it.
        #29 reports_published: UInt64;

        // How many reports were dropped off the front of the ring to make room,
        // all run. A rise says narration was lost, never a record: what mattered
        // about a fault travelled on the channel that raised it.
        //
        // The lifetime figure, for the signal: it counts every eviction this
        // session made, including ones from a ring since cleared, so it and the
        // `timeline_dropped` above it differ across a clear. What a published
        // story carries is that one -- the number about the rows in front of the
        // reader -- and this one is what a reader of the signal totals.
        #30 reports_dropped: UInt64;

        // How many inbound datagrams the codec refused, all run -- scripts,
        // driver events, aux outcomes and health reports together.
        #31 undecodable_inbound: UInt64;

        // How many times this slot could not be read back as a session, all
        // run. This cog is the only writer, so a rise means memory nobody wrote
        // was read as a session.
        #32 refused_state: UInt64;

        // The rows a degrade response still owes a verified torque-off write.
        // Empty when nothing is owed. The doctrine's one group-scoped response
        // is drained one row per wake: a row leaves the set when the driver
        // reports its write verified, and the whole set is dropped when the
        // machine is commanded fully limp instead, which owes no group write.
        #33 degrade_release: joints::JointFlags;

        // How many answers named a number nothing was waiting on. A late
        // duplicate of a request already settled -- what a re-issue produces
        // when the first datagram was answered after all -- dropped as it is
        // read. A rise says the link lost answers, not that anything went wrong
        // with the machine.
        #34 aux_strays: UInt64;

        // The rows whose health reading has already been recorded as a fault. A
        // servo's hardware-error byte latches in the servo, so the driver's
        // rotation carries it on every pass for the rest of the session; this is
        // what makes the condition news once. Nothing clears it -- nothing
        // clears the servo's own byte either, and there is no automatic recovery
        // from a fault.
        #35 health_faulted: joints::JointFlags;

        // When the standing torque-off was commanded. What an unconfirmed report
        // states as the time spent trying: the deadline above re-arms every time
        // the session says so, and the instant here does not, so a machine that
        // never acknowledges a release is reported as unconfirmed for longer and
        // longer rather than for one budget over and over.
        #36 torque_off_commanded: SyncTime;

        // Whether the transaction the aux record above is waiting on is the
        // degrade's own torque-off write rather than a sequence's ask. One
        // transaction is outstanding at a time and one record describes it, so
        // this is what says whose answer an outcome is: the drain settles its
        // own write, and a sequence is stepped by no wake that is draining.
        #37 degrade_pending: Bool;

        // How many reports were appended to the timeline, all run. The rows a
        // story datagram carries plus the ones it says were dropped -- and,
        // read against the same total at the top of an execution, what says
        // whether this wake had anything to add to the story.
        #38 reports_narrated: UInt64;

        // The id of the script the current engagement is on: the one that
        // opened it, or the last one to replace it. What a replacement's
        // number must be strictly greater than, compared only while the
        // machine is under command. Zero before any script has been accepted,
        // and never compared at rest -- a session beginning takes whatever
        // number it is offered, so a sender that reset its counter can still
        // raise the machine.
        //
        // Written together with `script_id` and equal to it at every instant a
        // reader can observe, and a separate field because they answer
        // different questions: `script_id` says which script the schedule was
        // built from, for a report that names it, and this one is the
        // admission floor the ordering screen tests against. A path that ever
        // re-anchors one without the other -- a wind-down that rebuilds the
        // schedule, a session ending that tidies the floor away -- would move
        // replacement admission, so their agreement is asserted as an
        // invariant rather than assumed.
        #39 active_script_id: UInt32;
    }
}
