# The decision tick's configuration, loaded once at process setup.
#
# Protobuf text of `brenn_reachy.cogs.config_clk_proto.MoverParams`, which the
# compiler generates from the `MoverParams` schema in `config.clk`. Read as it
# is: the box binds it by path, and the casing converts it to the message the
# dial hands the cog.

# Date each goal two cycles ahead of the sample that decided it. That is the
# slack the whole loop gets between a pose being read and the answer having to
# be on the bus, and it is comfortably inside the driver's queue.
lag_k: 2

# The bus cycle: 20 ms, which is the grid the simulated driver's samples sit on
# and the unit `lag_k` counts in. The two have to agree -- a goal dated in
# cycles of a length the driver does not run on lands at the wrong instant.
period_ns: 20000000

# The tracking detector judges every joint. False is for a capability run alone
# -- a measurement commissioned at a profile the motors cannot follow, where
# the model is known wrong -- and no shipped configuration carries it. The
# scenario suite pins this true, and both analyzers fail any run whose recorded
# configuration says otherwise.
tracking_armed: true

# A look's head carries up to 0.16 rad (about 9 degrees) of the bearing; the body
# yaw carries the rest.
look_head_share_rad: 0.16

# The head's clock for a look, and a lower bound: the tick's floor lengthens it
# for whichever joint cannot carry its span on it from where the machine stands,
# so a look runs as fast as the joints allow. 400 ms is the latency a look asks
# for from a raised head; from the fold the legs need 446-556 ms.
look_head_ms: 400
