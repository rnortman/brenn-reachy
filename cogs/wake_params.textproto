# The wake gesture, loaded once at process setup.
#
# Protobuf text of `brenn_reachy.cogs.config_clk_proto.WakeParams`, generated
# from the `WakeParams` schema in `config.clk`.
#
# The gesture is S1's, the scenario the deterministic suite pins end to end:
# commission, engage, raise, hold, stow, verified release, rest. So the first
# thing a machine does under this system is a sequence every assertion in that
# scenario already covers, and the run ends with the machine de-torqued at the
# minimum risk condition rather than holding a posture.

# Any number. What it buys is that the acceptance the session narrates names the
# request this cog made.
script_id: 1

# The room the session gets between this script arriving and its first step
# opening: eight seconds. The whole start-up survey has to fit in it, and the
# survey is 99 transactions (a ping, a model read, a supply reading and an error
# byte per servo, the two provisioning cells per servo the table checks, and the
# 45 gains and profile writes), each allowed three bus cycles where two is what
# a transaction costs with nothing in its way -- so the allowance carries about
# two seconds of padding of its own. That is 297 cycles, 5.94 s, and eight
# seconds adds about two seconds on top of it, for the retries a noisy bus costs
# beyond the per-transaction allowance on a path nothing has measured on
# hardware. An overrun is not a hazard: the mover commands nothing until the
# machine is armed, so a survey that outruns the lead costs the gesture its
# window -- a late, truncated or skipped first step -- never a command to an
# unarmed machine. What it buys is worth two seconds of stillness once per
# session. `//cogs:scenario_test` asserts the product against this number, so a
# register added to any of those sweeps fails there, and
# `commission_allowance_cycles` beside that assertion is where the three-cycle
# allowance is derived.
lead_ms: 8000

# Up, and hold there. Two seconds against the 800 ms the move is given, so most
# of the step is the machine holding the posture -- which is the point: a goal
# stream that stopped on arrival would trip the driver's dead-man, and a step
# this long is one that would.
steps
{
    after_ms: 0
    duration_ms: 2000
    kind: base_posture
    posture: up
}

# Then stow, and hold there until the schedule runs out -- which is what ends
# the session. Three seconds against the 2 s the longer move is given, on the
# same terms as the step above.
steps
{
    after_ms: 2000
    duration_ms: 3000
    kind: base_posture
    posture: stow
}
