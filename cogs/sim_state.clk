// The simulated machine: what a scenario does to it, and everything the
// simulated driver carries from one cycle to the next.
//
// `motor_sim` is the only writer and the only reader of the state below, and
// the injections are fed to it from an input log, which is why this sits in
// `cogs/` beside that cog. Nothing on the real machine ever sees either: the
// plant stands in for a physical world, and an injection stands in for a hand
// on it.
//
// The joint vocabulary -- which servo, which set, one number per servo -- is
// `motion/joints.clk`. The goal gate's own state is `driver/gate.clk` and the
// aux slot's, the torque belief's and the confirmation pass's is
// `driver/aux.clk` -- both imported under an alias because `SimState` carries
// fields called `gate` and `aux`, and a field name shadows a module name in the
// schema's scope, which the compiler refuses as a redefinition. Angles are
// radians about the model datum, the units `reachy-motion` uses, so nothing
// here converts.
//
// The totals are all-run counts, kept in the slot rather than in a signal
// group's own fold: a post-aggregated group folds over a bounded window and
// starts a new one when it reports, so a total kept only in the fold restarts
// mid-run.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::cogs)]

use driver::aux as aux_vocab;
use driver::gate as gate_vocab;
use hardware::dynamixel::registers;
use motion::joints;

// What a scenario does to the simulated machine.
//
// These stand in for the physical world and for the arming sequencer, neither
// of which exists in this system: a scenario torques the servos, teleports
// them, jams them, and cuts their replies, and the plant answers as it would.
// Nothing outside the simulator publishes one, and no cog on the real machine
// ever sees one.
enum SimOp
{
    uuid: 5e31bb5c-1905-49d9-93c0-9ff8e91da146;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // Nothing. The default a never-written slot decodes to.
        #0 nop default { underlying_value: 0; }
        // Energise the masked rows, as an arming sequence would.
        #1 torque_on { underlying_value: 1; }
        // De-energise the masked rows.
        #2 torque_off { underlying_value: 2; }
        // Teleport the masked rows to `positions`.
        #3 set_positions { underlying_value: 3; }
        // Jam the masked rows where they stand.
        #4 obstruct { underlying_value: 4; }
        // Release the masked rows.
        #5 release_obstruction { underlying_value: 5; }
        // Lose the next `count` cycles of position replies.
        #6 drop_replies { underlying_value: 6; }
        // Write `value` into the masked rows' `reg` register, as a hand on the
        // machine would: a servo whose rail sagged, whose error byte latched, or
        // whose provisioning is wrong. Refused for the registers the plant
        // owns -- where a servo is, what it is holding, whether it is energised
        // -- which are reached by moving the modelled machine instead.
        #7 set_register { underlying_value: 7; }
        // Swallow the next `count` out-of-band transactions the host asks for:
        // the request never reaches the modelled bus and no outcome comes back,
        // which is the world a host's own delivery timeout exists for. Values 8
        // and 9 are absent: writing a servo's error byte or its rail is
        // `set_register` naming that register, and a second name for it would be
        // a second way to say the same thing.
        #10 refuse_aux { underlying_value: 10; }
        // Stop the masked rows answering at all, as a servo off the bus does:
        // nothing comes back from a ping, a read or a write to one, and its
        // torque cannot be confirmed. The mask replaces the set, so an injection
        // naming nothing puts every servo back on the bus.
        #11 absent_servo { underlying_value: 11; }
        // Give the masked rows a response delay of `count` cycles: each of them
        // chases the target it was given that many cycles ago rather than the
        // one it holds now. A servo whose loop takes time to turn round, which
        // is what a lag on a real antenna is. The mask replaces the set, so an
        // injection naming nothing makes every row follow at once again, and a
        // delay longer than the plant's ring is refused rather than truncated.
        #12 set_lag { underlying_value: 12; }
    }
}

// One injection.
schema SimCmd
{
    uuid: a740edb8-b229-4ad3-9a5c-7fbf7e34281d;
    fields
    {
        // What to do.
        #0 op: SimOp;

        // Which servos it applies to.
        #1 mask: joints::JointFlags;

        // The positions `set_positions` teleports to, radians.
        #2 positions: joints::Joints;

        // How many cycles of replies `drop_replies` loses, how many of the
        // host's transactions `refuse_aux` swallows, or how many cycles of
        // response delay `set_lag` gives the masked rows.
        #3 count: UInt32;

        // Which register `set_register` writes.
        #4 reg: registers::RegId;

        // What `set_register` writes, as the eight bytes a register value is
        // carried in read as one little-endian number. Bits rather than a number
        // of anything: what they mean is the register's own engineering shape,
        // which the bus table names, so an angle crosses here as its own
        // IEEE-754 pattern.
        #5 value: UInt64;
    }
}

// Everything the simulated driver carries from one cycle to the next: the goal
// gate's own state, and the plant it drives.
//
// The gate half is `driver/gate.clk`, carried whole: the same decision runs in
// the real driver, in this simulator and in the gate's own tests, and a second
// description of it here would be a second set of conditions under which a
// machine does not de-torque.
//
// The plant half is the modelled world: where the servos are, what they are
// being asked for, which of them are energised, which are jammed, and how many
// cycles of replies are still being swallowed. `positions` is ground truth and
// stays a slot rather than a read-back of the published samples, because during
// a reply-drop window the published sample deliberately misreports and the
// machine underneath it keeps moving.
//
// The register file is the modelled servos' control tables, which is what a real
// driver reaches over the wire and the only thing a transaction ever addresses.
// Its live cells are a view of the plant above, refreshed every cycle; the rest
// is how the unit is provisioned.
//
// The counters are the run's totals, kept here for the same reason the
// estimator's are: a post-aggregated signal group folds over a bounded window
// and restarts when it reports, so a total kept only in the fold restarts
// mid-run.
schema SimState
{
    uuid: 1ee7c510-5ae4-468e-8d08-59e7915b3b6d;
    fields
    {
        // Whether the first execution has run. Until it has, every field below
        // is whatever a default-constructed slot holds and none of it describes
        // a machine.
        #0 initialized: Bool;

        // Where the servos actually are, radians. Ground truth, whatever the
        // published sample says.
        #1 positions: joints::Joints;

        // Which servos are energised. An angle written to a row outside this
        // set moves nothing, as on a de-torqued Dynamixel.
        #2 torqued: joints::JointFlags;

        // What each servo is being asked to hold, radians. Written from the
        // held setpoint, one row at a time, and only for the rows its mask
        // names.
        #3 targets: joints::Joints;

        // Which rows of `targets` have ever been written. A row outside this
        // set has never been commanded and holds where it stands.
        #4 has_target: joints::JointFlags;

        // What has been commanded and what is queued for later, and when the
        // commander was last heard from. The gate decides over it directly;
        // there is no second form of it anywhere.
        #5 gate: gate_vocab::GateState;

        // Which servos are jammed. A jammed servo holds where it stands
        // whatever it is asked for, which is what an obstruction looks like to
        // a position loop.
        #6 obstructed: joints::JointFlags;

        // How many more cycles of position replies are swallowed. While this is
        // non-zero the published sample carries no reading at all.
        #7 drop_replies_left: UInt32;

        // How many goals have been written to the modelled servos, all run.
        #8 goals_executed: UInt64;

        // How many goals were refused because the queue was full, all run.
        #9 goals_dropped: UInt64;

        // How many times the dead-man latched torque off, all run.
        #10 hold_timeouts: UInt64;

        // How many goals named a set of servos this build does not know, all
        // run. A setpoint whose rows cannot be read is not a setpoint, so
        // nothing was queued for it.
        #11 refused_goals: UInt64;

        // How many events were raised on a cycle that had already reported one,
        // all run. An output carries one message per execution, so a cycle that
        // raises two events publishes one of them; this is how many were lost.
        #12 events_dropped: UInt64;

        // How many times this slot did not read back as a state, all run. This
        // cog is the only thing that writes it, so a rise means memory nobody
        // wrote: the slot is restarted from a cleared one, keeping these
        // totals.
        #13 refused_state_fields: UInt64;

        // How many injections this build could not carry out, all run: an
        // operation it does not know, one naming servos it does not know, or a
        // register write a control table refused -- counted per row for that
        // one, since a table refuses per servo. A scenario written against a
        // newer vocabulary than the binary running it would otherwise have its
        // hand on the machine discarded in silence.
        #14 refused_injections: UInt64;

        // The nine modelled control tables: one cell per register per bus row,
        // row-major, twenty-three registers to a row -- every register the
        // vocabulary names except its no-register zero, which names no cell.
        //
        // A cell holds the register's engineering-unit value in the same
        // shape-tagged eight-byte carriage a transaction uses, never a servo
        // count: counts are the bus layer's and nothing above it converts. Which
        // shape a given cell is read in is the bus table's answer, not a field
        // here.
        //
        // The live cells -- present position, goal position, torque enable --
        // are brought up to date from the plant above every cycle. The rest is
        // provisioning: what a healthy, correctly provisioned unit holds, so a
        // commissioning sequence verifies here against the numbers it verifies
        // against on hardware.
        #15 regs: FixedArray<UInt64, 207>;

        // How many plant readings never reached a control table, all run: an
        // angle the modelled world made non-finite has no eight-byte carriage,
        // so the cell keeps the last number it held and the reading is counted
        // here. Every finite-shaped cell is therefore finite, and a plant that
        // went non-finite says so as a total rather than as a plausible angle
        // in the sample.
        #16 refused_readings: UInt64;

        // Which out-of-band transaction the driver is holding for the host, how
        // far its health rotation has walked, and which servos it believes are
        // energised. The aux slot decides over it directly; there is no second
        // form of it anywhere, the same way the gate's state above is carried
        // whole.
        #17 aux: aux_vocab::AuxSlotState;

        // How far the confirmation pass has read a commanded de-torquing back,
        // and what it has already said about it. Carried whole for the same
        // reason: the pass that runs here is the pass the real driver runs.
        #18 confirm: aux_vocab::TorqueConfirmState;

        // How many of the host's datagrams the driver turned away as asks it
        // could not act on, all run: one asking nothing at all, or a transaction
        // offered while another was still pending. The host that fills that slot
        // is serial by construction -- it issues one transaction and waits for
        // its outcome -- so the second of those says the host is not what it
        // claims to be, and it goes back as an outcome against the turned-away
        // request's own correlation number as well as being counted here. A
        // datagram this build could not read at all is a different diagnosis and
        // has its own total. Neither is liveness: a datagram the driver could
        // not act on is not evidence that the host is alive.
        #19 aux_refused: UInt64;

        // How many cycles in a row the bus has answered for no row at all. Zero
        // again on the first cycle that reads something. A run of them long
        // enough to mean something is the driver's own evidence that its bus is
        // gone -- the one fault a driver can raise about itself, since a process
        // that cannot read the machine cannot see what is wrong with it.
        #20 blind_cycles: UInt32;

        // How many more of the host's out-of-band transactions are swallowed
        // before they reach the modelled bus. While this is non-zero a request
        // the slot handed out is dropped whole: nothing about the machine
        // changes and no outcome goes back, so what the host meets is the
        // silence its own delivery timeout is for.
        #21 aux_unanswered_left: UInt32;

        // Which servos are off the bus. A row in this set answers nothing at
        // all -- no ping, no read, no write -- and its torque can therefore
        // never be confirmed off, which is the reading a de-torquing that cannot
        // be verified must have.
        #22 absent: joints::JointFlags;

        // How many of the host's datagrams this build could not read at all, all
        // run. A schema-version mismatch at the boundary rather than anything
        // about the machine or about what the host asked for: the bytes describe
        // no datagram, so there is no ask to refuse and nothing to answer
        // against. Kept apart from the asks the driver turned away because the
        // two send a reader to different places.
        #23 undecodable_inbound: UInt64;

        // When this process released the machine it met, which is the first
        // thing the first execution does and the last time it is done unasked.
        // The real driver's process-start sweep, modelled: a driver cannot know
        // what a predecessor left energised, so it de-torques before it does
        // anything else. Zero only before the first execution has run.
        #24 swept_at: SyncTime;

        // When the first pose sample went out, and zero until one has. Every
        // cycle publishes one, so this is the first cycle's instant on any run
        // that has had a cycle.
        #25 first_pose: SyncTime;

        // When the first of the host's datagrams was taken off the input, and
        // zero until one has been. Read on the same clock as `first_pose`, and
        // the datagrams are taken before the sample goes out, so a host that
        // commanded the machine on the cycle that first showed it one ties
        // rather than following.
        #26 first_session_cmd: SyncTime;

        // How many cycles have run since the last status record was published.
        // The cadence is counted in cycles rather than measured against a clock
        // so that it is a simulated second under any grid the scenario sets.
        #27 cycles_since_status: UInt32;

        // How many cycles have run, all run.
        #28 cycles: UInt64;

        // How many grid points passed without a cycle running, all run. An
        // execution that covers more than one cycle of plant motion is a
        // process that lost the CPU, and the points it stepped over are points
        // no cycle attended.
        #29 skipped_cycles: UInt64;

        // How many of the host's datagrams have been taken off the input, all
        // run -- every one of them, including the ones no ask could be read out
        // of. What the census of the channel they arrived on counts.
        #30 session_cmds_taken: UInt64;

        // How many setpoints have been taken off the goal input, all run, on
        // the same terms.
        #31 goals_taken: UInt64;

        // How many messages this cog has published, all run: the samples, the
        // events, the outcomes, the health reports and the status records.
        #32 published: UInt64;

        // How many delivery re-issues the aux slot recognised, all run: the
        // same correlation number carrying the same bytes as the request it
        // already holds. Not a refusal -- the pending request's own outcome
        // answers both copies.
        #33 aux_duplicates: UInt64;

        // How many health reports have gone out, all run.
        #34 health_reports: UInt64;

        // How many of the rotation's reads answered nothing, all run: a blind
        // cycle, or a servo off the bus. No report goes out for one.
        #35 health_misses: UInt64;

        // How many cycles the bus answered nothing on, all run. The total,
        // where `blind_cycles` above is the run of them the driver is standing
        // in right now: the first is what an outage cost a run, the second is
        // what says the bus is gone.
        #36 blind_cycles_total: UInt64;

        // How many of the confirmation pass's read-backs answered nothing, all
        // run. Each one counts as a row still holding torque, because a
        // de-torquing credited to silence is the one report a driver must never
        // make.
        #37 confirm_misses: UInt64;

        // The engagement the host asked for, if one is outstanding. The
        // engagement decides over it directly, the same way the gate's state
        // and the aux slot's above are carried: the real driver keeps this
        // declaration in its own memory, and two drivers disagreeing about when
        // an engagement may be written would be two machines.
        #38 engage: aux_vocab::EngageRequestState;

        // Which servos chase a target `lag_cycles` old rather than the one they
        // hold now. A response delay, which on this plant is the only way a row
        // lags a goal it is not jammed against.
        #39 lagged: joints::JointFlags;

        // How many cycles of response delay the rows above run at. One number
        // for the whole set, so an injection re-times the rows already lagged
        // as well as the ones it names for the first time: two depths cannot
        // coexist, and the later injection's mask and depth are the whole rule.
        #40 lag_cycles: UInt32;

        // What each row was being asked for on each of the last cycles, radians:
        // nine rings, row-major, `history_cursor` naming this cycle's cell in
        // each. A row's whole ring is filled with its first target, so a delay
        // never chases a cell nothing has written. Only a row entering the
        // lagged set is filled that way: a row already lagged keeps its history
        // across a further injection, so restating the same delay over a moving
        // row does not jump the target it is chasing forward to the present
        // one. What is kept is the ring, not the depth: an injection that names
        // a moving row at a *different* depth reads that same history one or
        // more cells further back or forward, so the target that row is chasing
        // steps by the difference in one cycle. A scenario measuring how far a
        // row stands behind its goal changes a standing depth at its own cost.
        #41 target_history: FixedArray<Float64, 288>;

        // Which cell of each ring above the newest target sits in. Walks one
        // cell per cycle of plant motion and wraps.
        #42 history_cursor: UInt32;
    }
}
