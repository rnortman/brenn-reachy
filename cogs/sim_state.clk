// The simulated machine: what a scenario does to it, and everything the
// simulated driver carries from one cycle to the next.
//
// `motor_sim` is the only writer and the only reader of the state below, and
// the injections are fed to it from an input log, which is why this sits in
// `cogs/` beside that cog. Nothing on the real machine ever sees either: the
// plant stands in for a physical world, and an injection stands in for a hand
// on it.
//
// The joint vocabulary -- which servo, which set, one number per servo -- is
// `motion/joints.clk`. The goal gate's own state is `driver/gate.clk`,
// imported under an alias because `SimState` carries a field called `gate` and
// a field name shadows a module name in the schema's scope, which the compiler
// refuses as a redefinition. Angles are radians about the model datum, the
// units `reachy-motion` uses, so nothing here converts.
//
// The totals are all-run counts, kept in the slot rather than in a signal
// group's own fold: a post-aggregated group folds over a bounded window and
// starts a new one when it reports, so a total kept only in the fold restarts
// mid-run.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::cogs)]

use driver::gate as gate_vocab;
use motion::joints;

// What a scenario does to the simulated machine.
//
// These stand in for the physical world and for the arming sequencer, neither
// of which exists in this system: a scenario torques the servos, teleports
// them, jams them, and cuts their replies, and the plant answers as it would.
// Nothing outside the simulator publishes one, and no cog on the real machine
// ever sees one.
enum SimOp
{
    uuid: 5e31bb5c-1905-49d9-93c0-9ff8e91da146;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // Nothing. The default a never-written slot decodes to.
        #0 nop default { underlying_value: 0; }
        // Energise the masked rows, as an arming sequence would.
        #1 torque_on { underlying_value: 1; }
        // De-energise the masked rows.
        #2 torque_off { underlying_value: 2; }
        // Teleport the masked rows to `positions`.
        #3 set_positions { underlying_value: 3; }
        // Jam the masked rows where they stand.
        #4 obstruct { underlying_value: 4; }
        // Release the masked rows.
        #5 release_obstruction { underlying_value: 5; }
        // Lose the next `count` cycles of position replies.
        #6 drop_replies { underlying_value: 6; }
    }
}

// One injection.
schema SimCmd
{
    uuid: a740edb8-b229-4ad3-9a5c-7fbf7e34281d;
    fields
    {
        // What to do.
        #0 op: SimOp;

        // Which servos it applies to.
        #1 mask: joints::JointFlags;

        // The positions `set_positions` teleports to, radians.
        #2 positions: joints::Joints;

        // How many cycles of replies `drop_replies` loses.
        #3 count: UInt32;
    }
}

// Everything the simulated driver carries from one cycle to the next: the goal
// gate's own state, and the plant it drives.
//
// The gate half is `driver/gate.clk`, carried whole: the same decision runs in
// the real driver, in this simulator and in the gate's own tests, and a second
// description of it here would be a second set of conditions under which a
// machine does not de-torque.
//
// The plant half is the modelled world: where the servos are, what they are
// being asked for, which of them are energised, which are jammed, and how many
// cycles of replies are still being swallowed. `positions` is ground truth and
// stays a slot rather than a read-back of the published samples, because during
// a reply-drop window the published sample deliberately misreports and the
// machine underneath it keeps moving.
//
// The counters are the run's totals, kept here for the same reason the
// estimator's are: a post-aggregated signal group folds over a bounded window
// and restarts when it reports, so a total kept only in the fold restarts
// mid-run.
schema SimState
{
    uuid: 1ee7c510-5ae4-468e-8d08-59e7915b3b6d;
    fields
    {
        // Whether the first execution has run. Until it has, every field below
        // is whatever a default-constructed slot holds and none of it describes
        // a machine.
        #0 initialized: Bool;

        // Where the servos actually are, radians. Ground truth, whatever the
        // published sample says.
        #1 positions: joints::Joints;

        // Which servos are energised. An angle written to a row outside this
        // set moves nothing, as on a de-torqued Dynamixel.
        #2 torqued: joints::JointFlags;

        // What each servo is being asked to hold, radians. Written from the
        // held setpoint, one row at a time, and only for the rows its mask
        // names.
        #3 targets: joints::Joints;

        // Which rows of `targets` have ever been written. A row outside this
        // set has never been commanded and holds where it stands.
        #4 has_target: joints::JointFlags;

        // What has been commanded and what is queued for later, and when the
        // commander was last heard from. The gate decides over it directly;
        // there is no second form of it anywhere.
        #5 gate: gate_vocab::GateState;

        // Which servos are jammed. A jammed servo holds where it stands
        // whatever it is asked for, which is what an obstruction looks like to
        // a position loop.
        #6 obstructed: joints::JointFlags;

        // How many more cycles of position replies are swallowed. While this is
        // non-zero the published sample carries no reading at all.
        #7 drop_replies_left: UInt32;

        // How many goals have been written to the modelled servos, all run.
        #8 goals_executed: UInt64;

        // How many goals were refused because the queue was full, all run.
        #9 goals_dropped: UInt64;

        // How many times the dead-man latched torque off, all run.
        #10 hold_timeouts: UInt64;

        // How many goals named a set of servos this build does not know, all
        // run. A setpoint whose rows cannot be read is not a setpoint, so
        // nothing was queued for it.
        #11 refused_goals: UInt64;

        // How many events were raised on a cycle that had already reported one,
        // all run. An output carries one message per execution, so a cycle that
        // raises two events publishes one of them; this is how many were lost.
        #12 events_dropped: UInt64;

        // How many times this slot did not read back as a state, all run. This
        // cog is the only thing that writes it, so a rise means memory nobody
        // wrote: the slot is restarted from a cleared one, keeping these
        // totals.
        #13 refused_state_fields: UInt64;

        // How many injections this build could not carry out, all run: an
        // operation it does not know, or one naming servos it does not know.
        // A scenario written against a newer vocabulary than the binary running
        // it would otherwise have its hand on the machine discarded in silence.
        #14 refused_injections: UInt64;
    }
}
