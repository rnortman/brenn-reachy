load("//bazel:rust_clk.bzl", "rust_clk_module")

# Rust crates for Clockwork's own `.clk` modules.
#
# A module that belongs to the drop is compiled under the drop's repository word
# rather than ours, and its crate name has to come out exactly as the generator
# spells it elsewhere -- a dial that carries an upstream message writes that
# message's type as `<upstream module's crate>::<type>`, and the crate has to
# exist under that name or nothing links. So each call here names `repo` and
# `crate_name` instead of taking the tree's defaults.

# The variable-size byte packet, which is how every wire-format channel in this
# repo's cog systems carries its datagrams. Its module instantiates a fixed menu
# of sizes; a channel may only name one of those, and the generator emits an
# instantiation into the crate of the module whose `instantiate` created it --
# so the sizes our channels use are chosen off that menu rather than declared
# here, and the crate below is where their Rust types come from.
# TODO(foreign-generic-instantiation-crate)
rust_clk_module(
    name = "var_packet_clk_rs",
    src = "@clockwork//clockwork/io:var_packet.clk",
    crate_name = "clockwork__clockwork__io__var_packet_clk_rs",
    repo = "clockwork",
)
