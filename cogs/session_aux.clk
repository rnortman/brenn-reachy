// The session's aux bookkeeping: the one transaction it is waiting on, and how
// such a transaction ends.
//
// Written by the session host, which is why it lives beside the cogs. What the
// transaction itself is, and what shape a register's value is, are the modules
// below this one.

#![generate(cpp)]
#![cpp(namespace=brenn_reachy::cogs)]

use hardware::dynamixel::registers;
use motion::bus_txn;

// How an aux transaction ended.
//
// Zero is `ok`, against the habit of leaving zero for "nothing wrote this": the
// transaction that ran without incident is the honest thing for a driver's
// freshly zeroed outcome to say it did. So a field of this type is only ever
// about a transaction some other field says happened.
//
// No slot field is typed with it yet. It stands here so that the first field
// that does carry an outcome status names the vocabulary instead of restating
// five numbers.
enum AuxStatus
{
    uuid: 3bea97c4-f9c1-4867-9e8a-0dcc18154d48;
    options
    {
        underlying_type: UInt8;
    }
    values
    {
        // The servo answered, and the answer is in the payload.
        #0 ok default { underlying_value: 0; }
        // Nothing came back inside the driver's own window.
        #1 timeout { underlying_value: 1; }
        // Something came back and was not a reply.
        #2 decode_error { underlying_value: 2; }
        // The bus itself failed the transaction.
        #3 wire_error { underlying_value: 3; }
        // The driver declined to run it, so nothing reached the bus.
        #4 refused { underlying_value: 4; }
    }
}

// The one aux transaction the session is waiting on, or that it is waiting on
// none.
//
// One and not a queue: the session is strictly serial by construction -- a
// sequencer hands out one transaction at a time and is stepped again when the
// answer comes back -- and the driver refuses a second outstanding request
// loudly rather than buffering it. So the slot holds exactly what a re-issue
// needs: the datagram's own fields, when it went out, and how many times it has.
//
// The request is held field for field rather than as encoded bytes. A re-issue
// must be the same datagram, correlation number included, and rebuilding it from
// the fields is the same encode the first one went through -- where a stored
// datagram would be a second representation able to disagree with the fields
// beside it.
schema AuxPending
{
    uuid: 5b9d7fc8-9da7-4d0e-aece-9a2751d14357;
    fields
    {
        // Whether a transaction is outstanding. Every field below means nothing
        // when this is false, and the zero operation is what a slot nothing
        // wrote holds.
        #0 active: Bool;

        // The correlation number the request went out with, and the only thing
        // that matches an outcome to it. A re-issue keeps it, so a late
        // duplicate of an answered request is recognisable as one.
        #1 corr: UInt32;

        // Which transaction it is.
        #2 op: bus_txn::AuxOpKind;

        // Which servo, as its bus id.
        #3 id: UInt8;

        // Which register, or `none` where the transaction concerns none. Not a
        // servo address: the address table lives below the wire line, in the
        // driver's bus layer.
        #4 reg: registers::RegId;

        // What shape the value below is.
        #5 value_kind: registers::ValueShape;

        // The value, as the eight bytes the wire carries it in read as one
        // little-endian number. Bits rather than a number of anything: what they
        // mean is `value_kind`, and an angle crosses here as its own IEEE-754
        // pattern.
        #6 value: UInt64;

        // When the request was last put on the wire. What the timeout is
        // measured from, so a re-issue restarts it.
        #7 issued: SyncTime;

        // How many times it has been re-issued. The budget is configured; past
        // it, the sequencer is handed a silence and fails the sequence itself.
        #8 retries: UInt32;
    }
}
